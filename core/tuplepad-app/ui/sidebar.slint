import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct DocItem {
    name: string,
    folder: string,
    detail: string,
    badge: string,
    tint: color,
    modified: bool,
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> on;
    callback clicked;
    width: 30px;
    height: 28px;
    border-radius: 7px;
    background: touch.pressed ? Theme.control-pressed : touch.has-hover || root.on ? Theme.control-hover : transparent;
    animate background { duration: 100ms; }

    Path {
        width: 16px;
        height: 16px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        fill: transparent;
        stroke: root.on ? Theme.accent.mix(Theme.icon, 0.5) : Theme.icon;
        stroke-width: 1.7px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A rounded text button, filled with the accent when it's the main choice.
export component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked;
    height: 26px;
    border-radius: 13px;
    background: root.primary
        ? (touch.pressed ? Theme.accent.darker(0.15) : Theme.accent)
        : (touch.pressed ? Theme.control-pressed : touch.has-hover ? Theme.control-hover : transparent);
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.control-border;
    animate background { duration: 100ms; }
    HorizontalLayout {
        padding-left: 13px;
        padding-right: 13px;
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: 600;
            color: root.primary ? Theme.accent-text : Theme.primary-text;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A file or folder in the sidebar's folder tree.
export struct FolderRow {
    name: string,
    depth: int,
    folder: bool,
    expanded: bool,
    // A file's extension, for its badge.
    badge: string,
    // The document showing in the editor.
    current: bool,
}

export global Icons {
    out property <string> sidebar: "M4 5.5h16a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1z M9.5 5.5v13";
    out property <string> plus: "M12 5.5v13 M5.5 12h13";
    out property <string> wrap: "M4 6.5h16 M4 12h13a3 3 0 0 1 0 6h-4.5 M14.5 15.5l-2.5 2.5 2.5 2.5 M4 18h5";
    out property <string> moon: "M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.6 6.6 0 0 0 10.7 10.7z";
    out property <string> alert: "M12 3.5l9 16H3z M12 10v4.5 M12 17.3v.2";
    out property <string> folder: "M3.5 7a2 2 0 0 1 2-2h4l2 2.2h7a2 2 0 0 1 2 2V17a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z";
    out property <string> close: "M7 7l10 10 M17 7L7 17";
    out property <string> gear: "M12 15a3 3 0 1 0 0-6a3 3 0 1 0 0 6z M19.4 13.5a7.6 7.6 0 0 0 0-3l2-1.5-2-3.4-2.3.9a7.6 7.6 0 0 0-2.6-1.5L14 2.5h-4l-.5 2.5a7.6 7.6 0 0 0-2.6 1.5l-2.3-.9-2 3.4 2 1.5a7.6 7.6 0 0 0 0 3l-2 1.5 2 3.4 2.3-.9a7.6 7.6 0 0 0 2.6 1.5l.5 2.5h4l.5-2.5a7.6 7.6 0 0 0 2.6-1.5l2.3.9 2-3.4z";
    out property <string> sun: "M12 17a5 5 0 1 0 0-10a5 5 0 1 0 0 10z M12 1.5v2 M12 20.5v2 M4.6 4.6l1.4 1.4 M18 18l1.4 1.4 M1.5 12h2 M20.5 12h2 M4.6 19.4l1.4-1.4 M18 6l1.4-1.4";
}

component DocRow inherits Rectangle {
    in property <DocItem> item;
    in property <bool> selected;
    in property <string> file-manager-title;
    in property <string> trash-title;
    callback clicked;
    callback close;
    // A context menu item, by command id.
    callback action(id: string);

    property <bool> hovered: touch.has-hover || close-touch.has-hover;
    height: 52px;
    border-radius: 10px;
    background: root.selected ? Theme.selected-row : root.hovered ? Theme.sidebar-hover : transparent;
    animate background { duration: 120ms; easing: ease-out; }

    property <bool> saved: root.item.folder != "Not saved";
    menu-area := ContextMenuArea {
        Menu {
            MenuItem { title: "Save"; activated => { root.action("file.save"); } }
            MenuItem { title: "Save As…"; activated => { root.action("file.save-as"); } }
            MenuItem { title: "Rename or Move…"; enabled: root.saved; activated => { root.action("file.move"); } }
            MenuSeparator { }
            MenuItem { title: root.file-manager-title; enabled: root.saved; activated => { root.action("file.show"); } }
            MenuItem { title: "Copy Path"; enabled: root.saved; activated => { root.action("file.copy-path"); } }
            MenuSeparator { }
            MenuItem { title: "Close"; activated => { root.action("file.close"); } }
            MenuItem { title: "Close Others"; activated => { root.action("file.close-others"); } }
            MenuSeparator { }
            MenuItem { title: root.trash-title; enabled: root.saved; activated => { root.action("file.trash"); } }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            // A middle click closes the document, as on tabs; a right click shows its menu.
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.middle {
                root.close();
            }
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                menu-area.show({ x: self.mouse-x, y: self.mouse-y });
            }
        }
    }

    // Closes the document; shows on hover, in the middle of the row's right edge.
    if root.hovered: Rectangle {
        x: parent.width - self.width - 10px;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: close-touch.pressed ? Theme.control-pressed : close-touch.has-hover ? Theme.control-hover : transparent;
        Path {
            width: 8px;
            height: 8px;
            viewbox-width: 8;
            viewbox-height: 8;
            commands: "M1 1L7 7 M7 1L1 7";
            fill: transparent;
            stroke: root.selected ? Theme.selected-row-text : Theme.secondary-text;
            stroke-width: 1.5px;
            stroke-line-cap: round;
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: root.hovered ? 36px : 12px;
        spacing: 11px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: root.selected && Theme.filled-selection ? Theme.selected-badge : root.item.tint.with-alpha(Theme.dark ? 0.22 : 0.13);
                Text {
                    text: root.item.badge;
                    font-size: 9.5px;
                    font-weight: 750;
                    letter-spacing: 0.4px;
                    color: root.selected && Theme.filled-selection ? Theme.selected-row-text : Theme.dark ? root.item.tint.mix(#FFFFFF, 0.45) : root.item.tint;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.item.name;
                    font-size: 13px;
                    font-weight: 600;
                    color: root.selected ? Theme.selected-row-text : Theme.primary-text;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                // The unsaved dot (the close button takes its place on hover).
                if root.item.modified && !root.hovered: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: root.selected ? Theme.selected-row-text : Theme.accent.mix(Theme.secondary-text, 0.7);
                    }
                }
            }
            Text {
                text: root.item.detail;
                font-size: 11px;
                color: root.selected ? Theme.selected-row-detail : Theme.secondary-text;
                overflow: elide;
            }
        }
    }

    close-touch := TouchArea {
        x: parent.width - 32px - 10px + 5px;
        y: (parent.height - 32px) / 2;
        width: 32px;
        height: 32px;
        enabled: root.hovered;
        clicked => { root.close(); }
    }
}

component FolderRowView inherits Rectangle {
    in property <FolderRow> item;
    in property <string> file-manager-title;
    in property <string> trash-title;
    callback clicked;
    callback action(id: string);
    height: 26px;
    border-radius: 6px;
    background: root.item.current ? Theme.selected-row : touch.has-hover ? Theme.sidebar-hover : transparent;
    HorizontalLayout {
        padding-left: 8px + root.item.depth * 14px;
        padding-right: 8px;
        spacing: 6px;
        Rectangle {
            width: 12px;
            if root.item.folder: Path {
                width: 9px;
                height: 9px;
                y: (parent.height - self.height) / 2;
                viewbox-width: 10;
                viewbox-height: 10;
                commands: root.item.expanded ? "M2 3.5l3 3 3-3" : "M3.5 2l3 3-3 3";
                fill: transparent;
                stroke: Theme.secondary-text;
                stroke-width: 1.5px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }
        if root.item.folder: Path {
            width: 15px;
            height: 15px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: Icons.folder;
            fill: Theme.accent.with-alpha(Theme.dark ? 0.35 : 0.18);
            stroke: Theme.dark ? Theme.accent.mix(#FFFFFF, 0.4) : Theme.accent;
            stroke-width: 1.6px;
            stroke-line-join: round;
        }
        if !root.item.folder: Rectangle {
            width: 15px;
            Rectangle {
                width: 11px;
                height: 14px;
                y: (parent.height - self.height) / 2;
                border-radius: 2.5px;
                border-width: 1.3px;
                border-color: root.item.current ? Theme.selected-row-text.with-alpha(0.7) : Theme.tertiary-text;
            }
        }
        Text {
            text: root.item.name;
            font-size: 12.5px;
            font-weight: root.item.current ? 600 : 400;
            color: root.item.current ? Theme.selected-row-text : Theme.primary-text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    menu-area := ContextMenuArea {
        Menu {
            if !root.item.folder: MenuItem { title: "Open"; activated => { root.action("open"); } }
            if root.item.folder: MenuItem { title: "Find in This Folder…"; activated => { root.action("find"); } }
            MenuSeparator { }
            MenuItem { title: root.file-manager-title; activated => { root.action("show"); } }
            MenuItem { title: "Copy Path"; activated => { root.action("copy-path"); } }
            MenuSeparator { }
            MenuItem { title: root.trash-title + "…"; activated => { root.action("trash"); } }
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                menu-area.show({ x: self.mouse-x, y: self.mouse-y });
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <[DocItem]> docs;
    in property <int> current;
    // The folder (Open Folder…), when there is one, and whether it's showing (1) or the
    // documents are (0).
    in property <string> folder-name;
    in property <[FolderRow]> folder-rows;
    in-out property <int> mode;
    callback folder-activate(index: int);
    callback folder-close();
    in property <string> file-manager-title;
    in property <string> trash-title;
    // A document row's context menu: the row, and the command chosen.
    callback doc-action(index: int, id: string);
    callback folder-action(index: int, id: string);
    in property <length> top-inset;
    callback select(index: int);
    callback close(index: int);
    callback toggle-sidebar();
    callback open-settings();
    callback drag-window();
    callback resize(width: length);
    // True while the edge is being dragged (the width follows the pointer without animating).
    out property <bool> resizing: handle.pressed;

    background: Theme.sidebar-background;
    clip: true;

    // The strip under the window buttons moves the window.
    TouchArea {
        y: 0;
        height: max(root.top-inset, 12px);
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { root.drag-window(); }
        }
    }

    IconButton {
        x: parent.width - self.width - 10px;
        y: max(0px, (root.top-inset - self.height) / 2 + 2px);
        visible: root.top-inset > 0;
        icon: Icons.sidebar;
        clicked => { root.toggle-sidebar(); }
    }

    VerticalLayout {
        padding-top: root.top-inset + 14px;
        padding-left: 10px;
        padding-right: 10px;
        padding-bottom: 12px;
        spacing: 2px;

        // DOCUMENTS, or DOCUMENTS and FOLDER as tabs when a folder is open.
        HorizontalLayout {
            padding-left: 10px;
            padding-bottom: 6px;
            spacing: 14px;
            for label[index] in root.folder-name == "" ? ["DOCUMENTS"] : ["DOCUMENTS", "FOLDER"]: Text {
                text: label;
                font-size: 10.5px;
                font-weight: 700;
                letter-spacing: 0.8px;
                color: root.folder-name == "" || root.mode == index ? Theme.secondary-text : tab-touch.has-hover ? Theme.secondary-text.with-alpha(0.8) : Theme.tertiary-text.with-alpha(0.7);
                tab-touch := TouchArea {
                    enabled: root.folder-name != "";
                    clicked => { root.mode = index; }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        if root.folder-name == "" || root.mode == 0: ListView {
            vertical-stretch: 1;
            for doc[index] in root.docs: Rectangle {
                height: 68px;
                DocRow {
                    y: 0;
                    height: 66px;
                    item: doc;
                    selected: index == root.current;
                    clicked => { root.select(index); }
                    close => { root.close(index); }
                    file-manager-title: root.file-manager-title;
                    trash-title: root.trash-title;
                    action(id) => { root.doc-action(index, id); }
                }
            }
        }

        if root.folder-name != "" && root.mode == 1: VerticalLayout {
            vertical-stretch: 1;
            spacing: 4px;
            HorizontalLayout {
                height: 28px;
                padding-left: 10px;
                spacing: 6px;
                Text {
                    text: root.folder-name;
                    font-size: 13px;
                    font-weight: 650;
                    color: Theme.primary-text;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                IconButton {
                    icon: Icons.close;
                    clicked => { root.folder-close(); }
                }
            }
            ListView {
                vertical-stretch: 1;
                for row[index] in root.folder-rows: FolderRowView {
                    item: row;
                    file-manager-title: root.file-manager-title;
                    trash-title: root.trash-title;
                    clicked => { root.folder-activate(index); }
                    action(id) => { root.folder-action(index, id); }
                }
            }
        }

        HorizontalLayout {
            padding-left: 10px;
            alignment: space-between;
            Text {
                text: root.docs.length == 1 ? "1 document" : root.docs.length + " documents";
                font-size: 11px;
                color: Theme.tertiary-text;
                vertical-alignment: center;
            }
            // Settings (appearance included: most people set it once).
            IconButton {
                icon: Icons.gear;
                clicked => { root.open-settings(); }
            }
        }
    }

    // The divider, which also resizes the sidebar.
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.separator;
    }
    handle := TouchArea {
        x: parent.width - 4px;
        width: 8px;
        mouse-cursor: col-resize;
        // The handle moves with the edge, so the offset from where it was grabbed is what's left to do.
        moved => {
            if self.pressed { root.resize(root.width + self.mouse-x - self.pressed-x); }
        }
    }
}
