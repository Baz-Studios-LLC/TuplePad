import { Theme } from "theme.slint";
import { PillButton } from "sidebar.slint";

// An on/off switch with a label.
export component Toggle inherits Rectangle {
    in-out property <bool> on;
    in property <string> text;
    callback toggled(on: bool);
    // A settings row's switch takes the row's label at the call site (`accessible-label`).
    accessible-role: switch;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => {
        root.on = !root.on;
        root.toggled(root.on);
    }
    height: 28px;
    // Just the switch when there's no label.
    max-width: root.text == "" ? 34px : 100000px;
    horizontal-stretch: 0;

    HorizontalLayout {
        spacing: root.text == "" ? 0px : 11px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 34px;
                height: 20px;
                border-radius: 10px;
                background: root.on ? Theme.accent : Theme.control-pressed;
                animate background { duration: 120ms; }
                Rectangle {
                    x: root.on ? parent.width - self.width - 2px : 2px;
                    y: 2px;
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: #FFFFFF;
                    drop-shadow-blur: 2px;
                    drop-shadow-offset-y: 1px;
                    drop-shadow-color: #00000033;
                    animate x { duration: 140ms; easing: ease-out; }
                }
            }
        }
        if root.text != "": Text {
            accessible-role: none;
            text: root.text;
            font-size: 13px;
            color: Theme.primary-text;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}

// A card over a dimmed window, for short questions and options. Return accepts, Esc cancels.
export component Sheet inherits Rectangle {
    in property <string> title;
    in property <string> accept-title: "OK";
    in property <length> card-width: 400px;
    in property <bool> show-cancel: true;
    in property <string> cancel-title: "Cancel";
    in property <bool> show-accept: true;
    in property <bool> accept-enabled: true;
    // A third button, on the left (like Skip This Version).
    in property <string> secondary-title;
    callback accept();
    callback cancel();
    callback secondary();

    background: Theme.scrim;

    // Clicks outside the card don't reach the window behind it.
    TouchArea { }

    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
                return EventResult.accept;
            }
            if event.text == Key.Return {
                if root.show-accept && root.accept-enabled { root.accept(); }
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }

    card := Rectangle {
        width: min(root.card-width, root.width - 40px);
        x: (parent.width - self.width) / 2;
        y: max(60px, (parent.height - self.height) / 3);
        height: content.preferred-height;
        border-radius: 14px;
        background: Theme.header-background;
        border-width: 1px;
        border-color: Theme.separator;
        drop-shadow-blur: 34px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: #00000059;

        content := VerticalLayout {
            padding: 22px;
            padding-top: 20px;
            spacing: 14px;
            Text {
                text: root.title;
                font-size: 15px;
                font-weight: 650;
                color: Theme.primary-text;
                overflow: elide;
            }
            @children
            HorizontalLayout {
                spacing: 8px;
                padding-top: 6px;
                if root.secondary-title != "": PillButton {
                    text: root.secondary-title;
                    clicked => { root.secondary(); }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.show-cancel: PillButton {
                    text: root.cancel-title;
                    clicked => { root.cancel(); }
                }
                if root.show-accept: PillButton {
                    text: root.accept-title;
                    primary: true;
                    opacity: root.accept-enabled ? 1 : 0.45;
                    clicked => {
                        if root.accept-enabled { root.accept(); }
                    }
                }
            }
        }
    }
}

// A row of mutually exclusive choices.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    callback chosen(index: int);
    accessible-role: radio-group;
    height: 28px;
    border-radius: 8px;
    background: Theme.control-hover;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for option[index] in root.options: Rectangle {
            accessible-role: radio-button;
            accessible-label: option;
            accessible-checkable: true;
            accessible-checked: index == root.selected;
            accessible-item-index: index;
            accessible-item-count: root.options.length;
            accessible-action-default => {
                root.selected = index;
                root.chosen(index);
            }
            border-radius: 6px;
            background: index == root.selected ? Theme.header-background : transparent;
            // (A shadow with no blur still draws, so unselected segments have none at all.)
            drop-shadow-blur: 3px;
            drop-shadow-offset-y: 1px;
            drop-shadow-color: index == root.selected ? #0000001F : transparent;
            animate background { duration: 120ms; }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    accessible-role: none;
                    text: option;
                    font-size: 12px;
                    font-weight: index == root.selected ? 600 : 500;
                    color: index == root.selected ? Theme.primary-text : Theme.secondary-text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                clicked => {
                    root.selected = index;
                    root.chosen(index);
                }
            }
        }
    }
}

// A number with − and + buttons.
export component Stepper inherits Rectangle {
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <string> suffix;
    callback changed(value: int);
    accessible-role: spinbox;
    accessible-value: root.value + root.suffix;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: 1;
    accessible-action-increment => { if root.value < root.maximum { root.changed(root.value + 1); } }
    accessible-action-decrement => { if root.value > root.minimum { root.changed(root.value - 1); } }
    height: 28px;
    width: 128px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.control-border;
    HorizontalLayout {
        minus := Rectangle {
            width: 32px;
            border-radius: 7px;
            background: minus-touch.pressed ? Theme.control-pressed : minus-touch.has-hover ? Theme.control-hover : transparent;
            Text { accessible-role: none; text: "−"; font-size: 15px; color: root.value > root.minimum ? Theme.primary-text : Theme.tertiary-text; horizontal-alignment: center; vertical-alignment: center; }
            minus-touch := TouchArea { clicked => { if root.value > root.minimum { root.changed(root.value - 1); } } }
        }
        Text {
            accessible-role: none;
            text: root.value + root.suffix;
            font-size: 13px;
            font-weight: 600;
            color: Theme.primary-text;
            horizontal-alignment: center;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        plus := Rectangle {
            width: 32px;
            border-radius: 7px;
            background: plus-touch.pressed ? Theme.control-pressed : plus-touch.has-hover ? Theme.control-hover : transparent;
            Text { accessible-role: none; text: "+"; font-size: 15px; color: root.value < root.maximum ? Theme.primary-text : Theme.tertiary-text; horizontal-alignment: center; vertical-alignment: center; }
            plus-touch := TouchArea { clicked => { if root.value < root.maximum { root.changed(root.value + 1); } } }
        }
    }
}

// A button showing the current choice, opening a list of the others.
export component Dropdown inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    in property <length> list-height: 260px;
    callback chosen(index: int);
    accessible-role: combobox;
    accessible-value: root.selected >= 0 && root.selected < root.options.length ? root.options[root.selected] : "";
    accessible-expandable: true;
    accessible-action-default => { popup.show(); }
    accessible-action-expand => { popup.show(); }
    height: 28px;
    min-width: 180px;
    preferred-width: 210px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.control-border;
    background: touch.has-hover ? Theme.control-hover : transparent;
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 9px;
        spacing: 8px;
        Text {
            accessible-role: none;
            text: root.selected >= 0 && root.selected < root.options.length ? root.options[root.selected] : "";
            font-size: 13px;
            color: Theme.primary-text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Path {
            width: 10px;
            height: 10px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 10;
            viewbox-height: 10;
            commands: "M2 3.5l3 3 3-3";
            fill: transparent;
            stroke: Theme.secondary-text;
            stroke-width: 1.5px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
    }
    touch := TouchArea {
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: min(root.list-height, root.options.length * 28px + 12px);
        Rectangle {
            border-radius: 10px;
            background: Theme.header-background;
            border-width: 1px;
            border-color: Theme.separator;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000040;
            clip: true;
            Flickable {
                content-height: root.options.length * 28px + 12px;
                VerticalLayout {
                    padding: 6px;
                    for option[index] in root.options: Rectangle {
                        accessible-role: list-item;
                        accessible-label: option;
                        accessible-item-selectable: true;
                        accessible-item-selected: index == root.selected;
                        accessible-item-index: index;
                        accessible-item-count: root.options.length;
                        accessible-action-default => {
                            root.chosen(index);
                            popup.close();
                        }
                        height: 28px;
                        border-radius: 6px;
                        background: option-touch.has-hover ? Theme.accent : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            Text {
                                accessible-role: none;
                                width: 14px;
                                text: index == root.selected ? "✓" : "";
                                font-size: 12px;
                                color: option-touch.has-hover ? Theme.accent-text : Theme.primary-text;
                                vertical-alignment: center;
                            }
                            Text {
                                accessible-role: none;
                                text: option;
                                font-size: 13px;
                                color: option-touch.has-hover ? Theme.accent-text : Theme.primary-text;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        option-touch := TouchArea {
                            clicked => {
                                root.chosen(index);
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

// A labeled group of settings rows, on a rounded card.
export component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 6px;
    if root.title != "": Text {
        text: root.title;
        font-size: 11px;
        font-weight: 650;
        letter-spacing: 0.4px;
        color: Theme.secondary-text;
    }
    Rectangle {
        border-radius: 10px;
        background: Theme.dark ? #FFFFFF08 : #00000005;
        border-width: 1px;
        border-color: Theme.separator;
        VerticalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 6px;
            padding-bottom: 6px;
            @children
        }
    }
}

// A settings row: a label on the left, its control on the right.
export component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> detail;
    min-height: 42px;
    spacing: 16px;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Text {
            text: root.label;
            font-size: 13px;
            color: Theme.primary-text;
        }
        if root.detail != "": Text {
            text: root.detail;
            font-size: 11px;
            color: Theme.secondary-text;
            wrap: word-wrap;
        }
    }
    // Controls sit at the right edge.
    HorizontalLayout {
        alignment: end;
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}
