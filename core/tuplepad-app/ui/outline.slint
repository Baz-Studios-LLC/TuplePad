import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Tick } from "controls.slint";

// One symbol in the outline.
export struct OutlineRow {
    name: string,
    // 0 function, 1 method, 2 type, 3 namespace, 4 heading, 5 constant, 6 property; for JSON
    // 7 object, 8 array, 9 string, 10 number, 11 true or false, 12 null.
    kind: int,
    depth: int,
    // A JSON value, or how many items an object or array has.
    detail: string,
}

export global OutlineBridge {
    in property <[OutlineRow]> items;
    // The item around the main caret.
    in property <int> current: -1;
    in property <string> empty-text;
    callback activate(index: int);
}

// A letter for each kind of symbol, tinted with the theme's syntax colors.
component KindBadge inherits Rectangle {
    in property <int> kind;
    property <color> tint: Theme.syntax[[7, 7, 8, 16, 17, 6, 10, 8, 16, 2, 5, 6, 6][root.kind]];
    width: 18px;
    height: 18px;
    border-radius: 5px;
    background: root.tint.with-alpha(Theme.dark ? 0.2 : 0.12);
    Text {
        text: ["ƒ", "m", "T", "N", "#", "C", "P", "{}", "[]", "\"", "1", "", ""][root.kind];
        font-size: 11px;
        font-weight: 700;
        color: root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // True or false, and null: drawn, since not every system's fonts have "✓" and "∅".
    if root.kind == 11: Tick { color: root.tint; }
    if root.kind == 12: Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M5 1.5a3.5 3.5 0 1 0 0 7a3.5 3.5 0 1 0 0-7z M1.8 8.2l6.4-6.4";
        fill: transparent;
        stroke: root.tint;
        stroke-width: 1.4px;
        stroke-line-cap: round;
    }
}

// The document's functions, types and headings, at the right of the window.
export component OutlinePanel inherits Rectangle {
    in property <length> header-height: 44px;
    background: Theme.sidebar-background;

    // Keeps the item around the caret in view.
    property <int> current: OutlineBridge.current;
    changed current => {
        if root.current < 0 {
            return;
        }
        let top = root.current * 28px;
        if top < -list.content-y {
            list.content-y = -max(0px, top - 56px);
        } else if top + 28px > -list.content-y + list.visible-height {
            list.content-y = -(top + 28px + 56px - list.visible-height);
        }
    }

    Rectangle {
        x: 0;
        width: 1px;
        background: Theme.separator;
    }

    VerticalLayout {
        Rectangle {
            height: root.header-height;
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 14px;
                Text {
                    text: "OUTLINE";
                    font-size: 11px;
                    font-weight: 650;
                    letter-spacing: 0.6px;
                    color: Theme.secondary-text;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            if OutlineBridge.items.length == 0: Text {
                x: 18px;
                y: 8px;
                width: parent.width - 36px;
                text: OutlineBridge.empty-text;
                font-size: 12px;
                color: Theme.tertiary-text;
                wrap: word-wrap;
            }
            list := ListView {
                for item[index] in OutlineBridge.items: Rectangle {
                    accessible-role: list-item;
                    accessible-label: item.name;
                    accessible-description: item.detail;
                    accessible-item-index: index;
                    accessible-item-count: OutlineBridge.items.length;
                    accessible-action-default => { OutlineBridge.activate(index); }
                    height: 28px;
                    Rectangle {
                        x: 8px;
                        width: parent.width - 16px;
                        border-radius: 6px;
                        background: index == OutlineBridge.current ? Theme.selected-row : touch.has-hover ? Theme.sidebar-hover : transparent;
                    }
                    HorizontalLayout {
                        padding-left: 16px + min(item.depth, 6) * 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            KindBadge { kind: item.kind; }
                        }
                        Text {
                            text: item.name;
                            font-size: 12.5px;
                            font-weight: index == OutlineBridge.current ? 600 : 400;
                            color: index == OutlineBridge.current ? Theme.selected-row-text : Theme.primary-text;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: item.detail == "" ? 1 : 0;
                        }
                        if item.detail != "": Text {
                            text: item.detail;
                            font-size: 12px;
                            font-family: item.kind >= 9 ? Theme.mono-family : "";
                            color: index == OutlineBridge.current ? Theme.selected-row-detail : Theme.secondary-text;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                    touch := TouchArea {
                        clicked => { OutlineBridge.activate(index); }
                    }
                }
            }
        }
    }
}
