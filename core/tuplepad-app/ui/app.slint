import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { EditorView, EditorBridge, Span, Row, Caret, Band, CompletionItem, ContextItem } from "editor.slint";
import { Sidebar, DocItem, FolderRow, IconButton, Icons, PillButton } from "sidebar.slint";
import { Sheet, Toggle } from "controls.slint";
import { SettingsWindow, SettingsValues, SnippetRow } from "settings.slint";
import { CommandPalette, PaletteItem, TitlePart } from "palette.slint";
import { FindBar, FindBridge } from "findbar.slint";
import { SearchPanel, SearchBridge, SearchRow, PlanRow, ReplacedRow, ReplacePlanSheet } from "searchpanel.slint";
import { ColumnEditorSheet, ColumnBridge } from "columneditor.slint";
import { OutlinePanel, OutlineBridge, OutlineRow } from "outline.slint";
import { ToolBridge, HashRow, XPathRow, HashesSheet, XPathSheet, CsvSortSheet, ShellSheet } from "toolsheets.slint";
import { ToolViewBridge, HexLine, CompareLine, HexView, CompareView } from "toolviews.slint";
import { PreviewBridge, PreviewBlock, CodeLine, CodePart, MarkdownPreview } from "preview.slint";
import { ShortcutsBridge, ShortcutSection, ShortcutRow, ShortcutsSheet } from "shortcuts.slint";
import { UpdateBridge, UpdateSheet } from "update.slint";

export { Theme, EditorBridge, Span, Row, Caret, Band, CompletionItem, ContextItem, DocItem, FolderRow, Palette, SettingsWindow, SettingsValues, SnippetRow, PaletteItem, TitlePart, FindBridge, SearchBridge, SearchRow, PlanRow, ReplacedRow, ColumnBridge, OutlineBridge, OutlineRow, ToolBridge, HashRow, XPathRow, ToolViewBridge, HexLine, CompareLine, PreviewBridge, PreviewBlock, CodeLine, CodePart, ShortcutsBridge, ShortcutSection, ShortcutRow, UpdateBridge }

// One entry of a menu, built in Rust from the command list. A separator is an entry whose title
// is Slint's separator placeholder.
// An item at the right of the status bar; one with an id opens a list to change it.
export struct StatusItem {
    id: string,
    text: string,
}

export struct MenuEntry {
    id: string,
    title: string,
    shortcut: keys,
    enabled: bool,
    checkable: bool,
    checked: bool,
}

export component AppWindow inherits Window {
    in property <string> window-title: "TuplePad";
    title: root.window-title;
    preferred-width: 1200px;
    preferred-height: 780px;
    min-width: 640px;
    min-height: 400px;
    background: Theme.editor-background;
    default-font-size: Theme.ui-font-size;

    // Room for the window buttons when the content runs under the title bar (macOS).
    in property <length> titlebar-height: 0px;
    // Where the sidebar button rests when the sidebar is closed: past the window buttons on a Mac.
    property <length> sidebar-button-x: root.titlebar-height > 0 ? 84px : 12px;
    in property <[DocItem]> docs;
    in property <int> current-doc;
    in property <string> doc-title;
    in property <string> doc-subtitle;
    in property <string> status-left;
    // The AI tools connected over MCP (empty when none), and whether one is working right now.
    in property <string> mcp-indicator;
    in property <bool> mcp-busy;
    in property <string> status-right;
    in property <[StatusItem]> status-items;
    in-out property <bool> sidebar-visible: true;
    in property <bool> outline-visible;
    // The folder in the sidebar (Open Folder…).
    in property <string> folder-name;
    // What the file manager and deleting are called on this system.
    in property <string> file-manager-title: "Show in Finder";
    in property <string> trash-title: "Move to Trash";
    in property <[FolderRow]> folder-rows;
    in-out property <int> sidebar-mode;
    // A short message at the bottom of the window.
    in property <string> toast;
    in property <bool> toast-shown;
    // Split view: 0 off, 1 side by side, 2 top and bottom; which pane has the keyboard; where
    // the divider is, as a fraction.
    in property <int> split;
    in property <int> focused-pane;
    in-out property <float> split-ratio: 0.5;
    in-out property <length> sidebar-width: 264px;
    in property <bool> wraps;
    // A note above the editor: 0 none, 1 the file changed on disk, 2 the file is gone.
    in property <int> banner;
    in property <string> banner-text;
    // A file is being dragged over the window.
    in property <bool> dropping;
    // The command palette.
    in property <bool> palette-open;
    in property <[PaletteItem]> palette-items;
    in-out property <int> palette-selected;
    in-out property <string> palette-text;
    in property <string> palette-placeholder: "Search commands, documents and recent files";
    callback palette-query(query: string);
    callback palette-run(index: int);
    callback palette-close();
    // The print options sheet.
    in-out property <bool> print-sheet;
    in-out property <bool> print-line-numbers: true;
    in-out property <bool> print-colors: true;

    in property <[MenuEntry]> file-menu;
    in property <[MenuEntry]> file-menu-2;
    in property <[MenuEntry]> file-menu-3;
    in property <[MenuEntry]> recent-menu;
    in property <[MenuEntry]> reopen-menu;
    in property <[MenuEntry]> convert-menu;
    in property <[MenuEntry]> line-ending-menu;
    in property <[MenuEntry]> edit-menu;
    in property <[MenuEntry]> selection-menu;
    in property <[MenuEntry]> find-menu;
    in property <[MenuEntry]> text-menu;
    in property <[MenuEntry]> lines-menu;
    in property <[MenuEntry]> case-menu;
    in property <[MenuEntry]> whitespace-menu;
    in property <[MenuEntry]> language-menu;
    in property <[MenuEntry]> tools-menu;
    in property <[MenuEntry]> compare-menu;
    in property <[MenuEntry]> compare-documents-menu;
    in property <[MenuEntry]> json-menu;
    in property <[MenuEntry]> xml-menu;
    in property <[MenuEntry]> csv-menu;
    in property <[MenuEntry]> encode-menu;
    in property <[MenuEntry]> decode-menu;
    in property <[MenuEntry]> view-menu;
    in property <[MenuEntry]> view-menu-2;
    in property <[MenuEntry]> view-menu-3;
    in property <[MenuEntry]> help-menu;
    in property <[MenuEntry]> folding-menu;
    in property <[MenuEntry]> theme-menu;

    callback command(id: string);
    callback select-doc(index: int);
    callback drag-window();
    callback sidebar-resized(width: length);

    // The search panel leaves the editor some room when the window gets smaller.
    changed height => {
        if SearchBridge.panel-height > self.height - 240px {
            SearchBridge.panel-height = max(150px, self.height - 240px);
        }
    }

    public function focus-editor() {
        if root.split != 0 && root.focused-pane == 1 {
            editor2.focus-editor();
        } else {
            editor.focus-editor();
        }
    }

    public function focus-find() {
        find-bar.focus-find();
    }

    MenuBar {
        Menu {
            title: "File";
            for item in root.file-menu: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
            Menu {
                title: "Open Recent";
                enabled: root.recent-menu.length > 0;
                for item in root.recent-menu: MenuItem {
                    title: item.title;
                    enabled: item.enabled;
                    checkable: item.checkable;
                    checked: item.checked;
                    activated => { root.command(item.id); }
                }
            }
            for item in root.file-menu-2: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
            Menu {
                title: "Reopen with Encoding";
                enabled: root.reopen-menu.length > 0;
                for item in root.reopen-menu: MenuItem {
                    title: item.title;
                    enabled: item.enabled;
                    checkable: item.checkable;
                    checked: item.checked;
                    activated => { root.command(item.id); }
                }
            }
            Menu {
                title: "Convert to Encoding";
                enabled: root.convert-menu.length > 0;
                for item in root.convert-menu: MenuItem {
                    title: item.title;
                    enabled: item.enabled;
                    checkable: item.checkable;
                    checked: item.checked;
                    activated => { root.command(item.id); }
                }
            }
            Menu {
                title: "Line Endings";
                enabled: root.line-ending-menu.length > 0;
                for item in root.line-ending-menu: MenuItem {
                    title: item.title;
                    enabled: item.enabled;
                    checkable: item.checkable;
                    checked: item.checked;
                    activated => { root.command(item.id); }
                }
            }
            for item in root.file-menu-3: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
        }
        Menu {
            title: "Edit";
            for item in root.edit-menu: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
        }
        Menu {
            title: "Selection";
            for item in root.selection-menu: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
        }
        Menu {
            title: "Find";
            for item in root.find-menu: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
        }
        Menu {
            title: "Text";
            for item in root.text-menu: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
            MenuSeparator { }
            Menu {
                title: "Lines";
                for item in root.lines-menu: MenuItem {
                    title: item.title;
                    shortcut: item.shortcut;
                    enabled: item.enabled;
                    checkable: item.checkable;
                    checked: item.checked;
                    activated => { root.command(item.id); }
                }
            }
            Menu {
                title: "Case";
                for item in root.case-menu: MenuItem {
                    title: item.title;
                    shortcut: item.shortcut;
                    enabled: item.enabled;
                    checkable: item.checkable;
                    checked: item.checked;
                    activated => { root.command(item.id); }
                }
            }
            Menu {
                title: "Whitespace";
                for item in root.whitespace-menu: MenuItem {
                    title: item.title;
                    shortcut: item.shortcut;
                    enabled: item.enabled;
                    checkable: item.checkable;
                    checked: item.checked;
                    activated => { root.command(item.id); }
                }
            }
        }
        Menu {
            title: "Language";
            for item in root.language-menu: MenuItem {
                title: item.title;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
        }
        Menu {
            title: "Tools";
            Menu {
                title: "Compare";
                for item in root.compare-menu: MenuItem {
                    title: item.title;
                    enabled: item.enabled;
                    activated => { root.command(item.id); }
                }
                Menu {
                    title: "With Document";
                    enabled: root.compare-documents-menu.length > 0;
                    for item in root.compare-documents-menu: MenuItem {
                        title: item.title;
                        activated => { root.command(item.id); }
                    }
                }
            }
            MenuSeparator { }
            Menu {
                title: "JSON";
                for item in root.json-menu: MenuItem {
                    title: item.title;
                    shortcut: item.shortcut;
                    enabled: item.enabled;
                    checkable: item.checkable;
                    checked: item.checked;
                    activated => { root.command(item.id); }
                }
            }
            Menu {
                title: "XML";
                for item in root.xml-menu: MenuItem {
                    title: item.title;
                    shortcut: item.shortcut;
                    enabled: item.enabled;
                    checkable: item.checkable;
                    checked: item.checked;
                    activated => { root.command(item.id); }
                }
            }
            Menu {
                title: "CSV";
                for item in root.csv-menu: MenuItem {
                    title: item.title;
                    shortcut: item.shortcut;
                    enabled: item.enabled;
                    checkable: item.checkable;
                    checked: item.checked;
                    activated => { root.command(item.id); }
                }
            }
            MenuSeparator { }
            Menu {
                title: "Encode";
                for item in root.encode-menu: MenuItem {
                    title: item.title;
                    shortcut: item.shortcut;
                    enabled: item.enabled;
                    checkable: item.checkable;
                    checked: item.checked;
                    activated => { root.command(item.id); }
                }
            }
            Menu {
                title: "Decode";
                for item in root.decode-menu: MenuItem {
                    title: item.title;
                    shortcut: item.shortcut;
                    enabled: item.enabled;
                    checkable: item.checkable;
                    checked: item.checked;
                    activated => { root.command(item.id); }
                }
            }
            for item in root.tools-menu: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
        }
        Menu {
            title: "View";
            for item in root.view-menu: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
            Menu {
                title: "Code Folding";
                for item in root.folding-menu: MenuItem {
                    title: item.title;
                    shortcut: item.shortcut;
                    enabled: item.enabled;
                    checkable: item.checkable;
                    checked: item.checked;
                    activated => { root.command(item.id); }
                }
            }
            for item in root.view-menu-2: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
            Menu {
                title: "Theme";
                for item in root.theme-menu: MenuItem {
                    title: item.title;
                    checkable: item.checkable;
                    checked: item.checked;
                    activated => { root.command(item.id); }
                }
            }
            for item in root.view-menu-3: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
        }
        Menu {
            title: "Help";
            for item in root.help-menu: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                activated => { root.command(item.id); }
            }
        }
    }

    HorizontalLayout {
        sidebar := Sidebar {
            width: root.sidebar-visible ? root.sidebar-width : 0px;
            full-width: root.sidebar-width;
            // Starts and settles gently, so the slide reads as one motion.
            animate width { duration: self.resizing ? 0ms : 260ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
            docs: root.docs;
            current: root.current-doc;
            top-inset: root.titlebar-height;
            close(index) => { root.command("close-doc:" + index); }
            folder-name: root.folder-name;
            folder-rows: root.folder-rows;
            mode <=> root.sidebar-mode;
            folder-activate(index) => { root.command("folder-row:" + index); }
            folder-close => { root.command("folder.close"); }
            file-manager-title: root.file-manager-title;
            trash-title: root.trash-title;
            doc-action(index, id) => { root.command("doc-action:" + index + ":" + id); }
            folder-action(index, id) => { root.command("folder-action:" + index + ":" + id); }
            select(index) => {
                root.select-doc(index);
                root.focus-editor();
            }
            open-settings => { root.command("app.settings"); }
            drag-window => { root.drag-window(); }
            resize(width) => { root.sidebar-resized(width); }
        }

        VerticalLayout {
            Rectangle {
                height: root.titlebar-height > 0 ? 52px : 44px;
                background: Theme.header-background;

                TouchArea {
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down { root.drag-window(); }
                    }
                }

                HorizontalLayout {
                    // The title clears the sidebar button as the sidebar closes (it follows the
                    // sidebar's width as it slides, so they move together).
                    padding-left: max(16px, root.sidebar-button-x + 30px + 8px - sidebar.width);
                    padding-right: 12px;
                    spacing: 8px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        padding-left: 6px;
                        Text {
                            text: root.doc-title;
                            font-size: 13.5px;
                            font-weight: 650;
                            color: Theme.primary-text;
                            overflow: elide;
                        }
                        Text {
                            text: root.doc-subtitle;
                            font-size: 11px;
                            color: Theme.secondary-text;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 2px;
                            IconButton {
                                icon: Icons.wrap;
                                label: "Word Wrap";
                                on: root.wraps;
                                clicked => {
                                    root.command("view.wrap");
                                    root.focus-editor();
                                }
                            }
                            IconButton {
                                icon: Icons.plus;
                                label: "New Document";
                                clicked => {
                                    root.command("file.new");
                                    root.focus-editor();
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.separator;
                }
            }

            Rectangle {
                height: root.banner == 0 ? 0px : 44px;
                clip: true;
                animate height { duration: 160ms; easing: ease-out; }
                background: Theme.dark ? #FFB0400F : #C2410C0D;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 14px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Path {
                            width: 16px;
                            height: 16px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: Icons.alert;
                            fill: transparent;
                            stroke: Theme.dark ? #F2B36D : #B4441B;
                            stroke-width: 1.8px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                        }
                    }
                    Text {
                        text: root.banner-text;
                        font-size: 12.5px;
                        color: Theme.primary-text;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            if root.banner == 1: PillButton {
                                text: "Keep Mine";
                                clicked => { root.command("disk.keep"); }
                            }
                            if root.banner == 1: PillButton {
                                text: "Reload";
                                primary: true;
                                clicked => { root.command("disk.reload"); }
                            }
                            if root.banner == 3: PillButton {
                                text: "Dismiss";
                                clicked => { root.command("binary.dismiss"); }
                            }
                            if root.banner == 3: PillButton {
                                text: "Hex View";
                                primary: true;
                                clicked => { root.command("tools.hex"); }
                            }
                            if root.banner == 2: PillButton {
                                text: "Close";
                                clicked => { root.command("file.close"); }
                            }
                            if root.banner == 2: PillButton {
                                text: "Save Again";
                                primary: true;
                                clicked => { root.command("disk.save"); }
                            }
                        }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.separator;
                }
            }

            find-bar := FindBar { }
            if FindBridge.open: Rectangle {
                height: 1px;
                background: Theme.separator;
            }

            panes := Rectangle {
                vertical-stretch: 1;
                property <bool> side: root.split == 1;
                property <bool> stacked: root.split == 2;
                // The Markdown preview takes the right half when it's open.
                property <length> editors-width: PreviewBridge.open ? round(self.width / 2 / 1px) * 1px : self.width;
                property <length> first-width: self.side ? round((self.editors-width - 1px) * root.split-ratio / 1px) * 1px : self.editors-width;
                property <length> first-height: self.stacked ? round((self.height - 1px) * root.split-ratio / 1px) * 1px : self.height;

                editor := EditorView {
                    pane: 0;
                    input-text <=> EditorBridge.input-text;
                    x: 0;
                    y: 0;
                    width: panes.first-width;
                    height: panes.first-height;
                    font-family: Theme.mono-family;
                }
                editor2 := EditorView {
                    pane: 1;
                    input-text <=> EditorBridge.input-text-2;
                    visible: root.split != 0;
                    x: panes.side ? panes.first-width + 1px : 0;
                    y: panes.stacked ? panes.first-height + 1px : 0;
                    width: root.split == 0 ? 0 : panes.side ? panes.editors-width - panes.first-width - 1px : panes.editors-width;
                    height: root.split == 0 ? 0 : panes.stacked ? panes.height - panes.first-height - 1px : panes.height;
                    font-family: Theme.mono-family;
                }
                // The divider between the panes; drag it to resize them.
                if root.split != 0: Rectangle {
                    x: panes.side ? panes.first-width : 0;
                    y: panes.stacked ? panes.first-height : 0;
                    width: panes.side ? 1px : panes.editors-width;
                    height: panes.stacked ? 1px : panes.height;
                    background: Theme.separator;
                    TouchArea {
                        x: panes.side ? -3px : 0;
                        y: panes.stacked ? -3px : 0;
                        width: panes.side ? 7px : parent.width;
                        height: panes.stacked ? 7px : parent.height;
                        mouse-cursor: panes.side ? col-resize : row-resize;
                        moved => {
                            if self.pressed {
                                if panes.side {
                                    root.split-ratio = max(0.2, min(0.8, (parent.x + self.mouse-x - 3px) / panes.width));
                                } else {
                                    root.split-ratio = max(0.2, min(0.8, (parent.y + self.mouse-y - 3px) / panes.height));
                                }
                            }
                        }
                    }
                }

                if PreviewBridge.open: MarkdownPreview {
                    x: panes.editors-width;
                    width: panes.width - panes.editors-width;
                }

                // Hex View and Compare cover the editors while they're open.
                if ToolViewBridge.view == 1: HexView { }
                if ToolViewBridge.view == 2: CompareView { }
            }

            if SearchBridge.open: SearchPanel {
                height: SearchBridge.panel-height;
                max-panel-height: root.height - 240px;
            }

            Rectangle {
                height: 27px;
                background: Theme.status-background;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.separator;
                }
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: root.status-left;
                            font-size: 11.5px;
                            color: Theme.secondary-text;
                            vertical-alignment: center;
                        }
                        if root.mcp-indicator != "": Rectangle {
                            y: 4px;
                            height: parent.height - 8px;
                            width: mcp-label.preferred-width + 24px;
                            border-radius: self.height / 2;
                            background: mcp-touch.has-hover ? Theme.control-hover : Theme.accent.with-alpha(Theme.dark ? 0.16 : 0.08);
                            // A dot that glows while the AI tool is working.
                            mcp-dot := Rectangle {
                                x: 8px;
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: Theme.dark ? Theme.accent.mix(#FFFFFF, 0.55) : Theme.accent;
                                opacity: root.mcp-busy ? 1 : 0.55;
                                animate opacity { duration: 300ms; }
                            }
                            mcp-label := Text {
                                x: 19px;
                                text: root.mcp-indicator;
                                font-size: 11px;
                                color: Theme.secondary-text;
                                vertical-alignment: center;
                            }
                            mcp-touch := TouchArea {
                                accessible-role: button;
                                accessible-label: root.mcp-indicator + " is connected (AI tools in Settings)";
                                accessible-action-default => { root.command("settings.ai"); }
                                mouse-cursor: pointer;
                                clicked => { root.command("settings.ai"); }
                            }
                        }
                        // An update to install, or one under way.
                        if UpdateBridge.pill != "": Rectangle {
                            y: 4px;
                            height: parent.height - 8px;
                            width: update-label.preferred-width + 24px;
                            border-radius: self.height / 2;
                            background: Theme.accent.with-alpha(update-touch.has-hover ? (Theme.dark ? 0.32 : 0.17) : (Theme.dark ? 0.22 : 0.10));
                            Rectangle {
                                x: 8px;
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: Theme.dark ? Theme.accent.mix(#FFFFFF, 0.55) : Theme.accent;
                            }
                            update-label := Text {
                                x: 19px;
                                text: UpdateBridge.pill;
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.dark ? Theme.accent.mix(#FFFFFF, 0.35) : Theme.accent;
                                vertical-alignment: center;
                            }
                            update-touch := TouchArea {
                                accessible-role: button;
                                accessible-label: UpdateBridge.pill;
                                accessible-action-default => { UpdateBridge.show(); }
                                mouse-cursor: pointer;
                                clicked => { UpdateBridge.show(); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 2px;
                        for item[index] in root.status-items: HorizontalLayout {
                            spacing: 2px;
                            if index > 0: Text {
                                accessible-role: none;
                                text: "·";
                                font-size: 11.5px;
                                color: Theme.tertiary-text;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                y: 3px;
                                height: parent.height - 6px;
                                width: status-label.preferred-width + 12px;
                                border-radius: 5px;
                                background: item.id != "" && item-touch.has-hover ? Theme.control-hover : transparent;
                                status-label := Text {
                                    accessible-role: none;
                                    text: item.text;
                                    font-size: 11.5px;
                                    color: item.id != "" && item-touch.has-hover ? Theme.primary-text : Theme.secondary-text;
                                    vertical-alignment: center;
                                }
                                item-touch := TouchArea {
                                    accessible-role: button;
                                    accessible-label: item.text;
                                    accessible-enabled: item.id != "";
                                    accessible-action-default => { if item.id != "" { root.command(item.id); } }
                                    enabled: item.id != "";
                                    mouse-cursor: item.id != "" ? pointer : default;
                                    clicked => { root.command(item.id); }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.outline-visible: OutlinePanel {
            width: 250px;
            header-height: root.titlebar-height > 0 ? 52px : 44px;
        }
    }

    // One button shows and hides the sidebar. It rides the sidebar's edge as it slides, and
    // comes to rest beside the window buttons (or the window's edge) when the sidebar is closed.
    IconButton {
        x: max(root.sidebar-button-x, sidebar.width - self.width - 10px);
        y: root.titlebar-height > 0 ? max(0px, (root.titlebar-height - self.height) / 2 + 2px) : (44px - self.height) / 2;
        icon: Icons.sidebar;
        label: "Show or Hide Sidebar";
        clicked => { root.command("view.sidebar"); }
    }

    // The toast: a short message that goes away by itself.
    Rectangle {
        property <bool> shown: root.toast-shown && root.toast != "";
        x: (parent.width - self.width) / 2 + sidebar.width / 2;
        y: parent.height - 27px - self.height - (shown ? 18px : 6px);
        width: label.preferred-width + 32px;
        height: 34px;
        border-radius: 17px;
        background: Theme.dark ? #3A3A3E : #1D1D1F;
        opacity: shown ? 0.96 : 0;
        // Out of the accessibility tree too once it has faded (screen readers would find an empty text).
        visible: shown || self.opacity > 0.01;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000040;
        animate opacity, y { duration: 180ms; easing: ease-out; }
        label := Text {
            text: root.toast;
            font-size: 12.5px;
            font-weight: 500;
            color: #FFFFFF;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Files dragged over the window.
    if root.dropping: Rectangle {
        background: Theme.drop-tint;
        border-width: 3px;
        border-color: Theme.dark ? #6F95E8 : Theme.accent.with-alpha(0.6);
        border-radius: 12px;
        Rectangle {
            width: 220px;
            height: 44px;
            border-radius: 22px;
            background: Theme.accent;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000033;
            Text {
                text: "Drop to open";
                color: Theme.accent-text;
                font-size: 14px;
                font-weight: 650;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    if root.print-sheet: Sheet {
        title: "Print “" + root.doc-title + "”";
        accept-title: "Print…";
        accept => { root.command("print.confirm"); }
        cancel => { root.command("print.cancel"); }
        Toggle {
            text: "Line numbers";
            on: root.print-line-numbers;
            toggled(on) => { root.print-line-numbers = on; }
        }
        Toggle {
            text: "Syntax colors";
            on: root.print-colors;
            toggled(on) => { root.print-colors = on; }
        }
    }

    if SearchBridge.plan-open: ReplacePlanSheet { }

    if ColumnBridge.open: ColumnEditorSheet { }
    if ToolBridge.sheet == 1: HashesSheet { }
    if ToolBridge.sheet == 2: XPathSheet { }
    if ToolBridge.sheet == 3: CsvSortSheet { }
    if ToolBridge.sheet == 4: ShellSheet { }
    if ShortcutsBridge.open: ShortcutsSheet { }
    if UpdateBridge.open: UpdateSheet { }

    if root.palette-open: CommandPalette {
        items: root.palette-items;
        text <=> root.palette-text;
        placeholder: root.palette-placeholder;
        selected <=> root.palette-selected;
        query-changed(query) => { root.palette-query(query); }
        run(index) => { root.palette-run(index); }
        close => { root.palette-close(); }
    }
}
