import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { EditorView, EditorBridge, Span, Row, Caret, Band } from "editor.slint";
import { Sidebar, DocItem, IconButton, Icons } from "sidebar.slint";

export { Theme, EditorBridge, Span, Row, Caret, Band, DocItem, Palette }

// One entry of a menu, built in Rust from the command list. A separator is an entry whose title
// is Slint's separator placeholder.
export struct MenuEntry {
    id: string,
    title: string,
    shortcut: keys,
    enabled: bool,
    checkable: bool,
    checked: bool,
}

export component AppWindow inherits Window {
    in property <string> window-title: "TuplePad";
    title: root.window-title;
    preferred-width: 1200px;
    preferred-height: 780px;
    min-width: 640px;
    min-height: 400px;
    background: Theme.editor-background;
    default-font-size: Theme.ui-font-size;

    // Room for the window buttons when the content runs under the title bar (macOS).
    in property <length> titlebar-height: 0px;
    in property <[DocItem]> docs;
    in property <int> current-doc;
    in property <string> doc-title;
    in property <string> doc-subtitle;
    in property <string> status-left;
    in property <string> status-right;
    in-out property <bool> sidebar-visible: true;
    in-out property <length> sidebar-width: 264px;
    in property <bool> wraps;

    in property <[MenuEntry]> file-menu;
    in property <[MenuEntry]> edit-menu;
    in property <[MenuEntry]> selection-menu;
    in property <[MenuEntry]> view-menu;

    callback command(id: string);
    callback select-doc(index: int);
    callback drag-window();
    callback sidebar-resized(width: length);

    public function focus-editor() {
        editor.focus-editor();
    }

    MenuBar {
        Menu {
            title: "File";
            for item in root.file-menu: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
        }
        Menu {
            title: "Edit";
            for item in root.edit-menu: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
        }
        Menu {
            title: "Selection";
            for item in root.selection-menu: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
        }
        Menu {
            title: "View";
            for item in root.view-menu: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
        }
    }

    HorizontalLayout {
        sidebar := Sidebar {
            width: root.sidebar-visible ? root.sidebar-width : 0px;
            animate width { duration: self.resizing ? 0ms : 180ms; easing: ease-in-out; }
            docs: root.docs;
            current: root.current-doc;
            top-inset: root.titlebar-height;
            select(index) => {
                root.select-doc(index);
                editor.focus-editor();
            }
            toggle-sidebar => { root.command("view.sidebar"); }
            toggle-theme => {
                root.command("view.toggle-theme");
                editor.focus-editor();
            }
            drag-window => { root.drag-window(); }
            resize(width) => { root.sidebar-resized(width); }
        }

        VerticalLayout {
            Rectangle {
                height: root.titlebar-height > 0 ? 52px : 44px;
                background: Theme.header-background;

                TouchArea {
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down { root.drag-window(); }
                    }
                }

                HorizontalLayout {
                    // Clear the window buttons when the sidebar is hidden.
                    padding-left: !root.sidebar-visible && root.titlebar-height > 0 ? 84px : 16px;
                    padding-right: 12px;
                    spacing: 8px;
                    animate padding-left { duration: 180ms; easing: ease-in-out; }

                    if !root.sidebar-visible: VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: Icons.sidebar;
                            clicked => { root.command("view.sidebar"); }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        padding-left: 6px;
                        Text {
                            text: root.doc-title;
                            font-size: 13.5px;
                            font-weight: 650;
                            color: Theme.primary-text;
                            overflow: elide;
                        }
                        Text {
                            text: root.doc-subtitle;
                            font-size: 11px;
                            color: Theme.secondary-text;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 2px;
                            IconButton {
                                icon: Icons.wrap;
                                on: root.wraps;
                                clicked => {
                                    root.command("view.wrap");
                                    editor.focus-editor();
                                }
                            }
                            IconButton {
                                icon: Icons.plus;
                                clicked => {
                                    root.command("file.new");
                                    editor.focus-editor();
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.separator;
                }
            }

            editor := EditorView {
                font-family: Theme.mono-family;
                vertical-stretch: 1;
            }

            Rectangle {
                height: 27px;
                background: Theme.status-background;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.separator;
                }
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    alignment: space-between;
                    Text {
                        text: root.status-left;
                        font-size: 11.5px;
                        color: Theme.secondary-text;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.status-right;
                        font-size: 11.5px;
                        color: Theme.secondary-text;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
