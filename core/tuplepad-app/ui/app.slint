import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { EditorView, EditorBridge, Span, Row, Caret, Band } from "editor.slint";
import { Sidebar, DocItem, IconButton, Icons, PillButton } from "sidebar.slint";
import { Sheet, Toggle } from "controls.slint";
import { SettingsWindow, SettingsValues } from "settings.slint";
import { CommandPalette, PaletteItem, TitlePart } from "palette.slint";
import { FindBar, FindBridge } from "findbar.slint";
import { SearchPanel, SearchBridge, SearchRow, PlanRow, ReplacedRow, ReplacePlanSheet } from "searchpanel.slint";

export { Theme, EditorBridge, Span, Row, Caret, Band, DocItem, Palette, SettingsWindow, SettingsValues, PaletteItem, TitlePart, FindBridge, SearchBridge, SearchRow, PlanRow, ReplacedRow }

// One entry of a menu, built in Rust from the command list. A separator is an entry whose title
// is Slint's separator placeholder.
export struct MenuEntry {
    id: string,
    title: string,
    shortcut: keys,
    enabled: bool,
    checkable: bool,
    checked: bool,
}

export component AppWindow inherits Window {
    in property <string> window-title: "TuplePad";
    title: root.window-title;
    preferred-width: 1200px;
    preferred-height: 780px;
    min-width: 640px;
    min-height: 400px;
    background: Theme.editor-background;
    default-font-size: Theme.ui-font-size;

    // Room for the window buttons when the content runs under the title bar (macOS).
    in property <length> titlebar-height: 0px;
    in property <[DocItem]> docs;
    in property <int> current-doc;
    in property <string> doc-title;
    in property <string> doc-subtitle;
    in property <string> status-left;
    in property <string> status-right;
    in-out property <bool> sidebar-visible: true;
    in-out property <length> sidebar-width: 264px;
    in property <bool> wraps;
    // A note above the editor: 0 none, 1 the file changed on disk, 2 the file is gone.
    in property <int> banner;
    in property <string> banner-text;
    // A file is being dragged over the window.
    in property <bool> dropping;
    // The command palette.
    in property <bool> palette-open;
    in property <[PaletteItem]> palette-items;
    in-out property <int> palette-selected;
    callback palette-query(query: string);
    callback palette-run(index: int);
    callback palette-close();
    // The print options sheet.
    in-out property <bool> print-sheet;
    in-out property <bool> print-line-numbers: true;
    in-out property <bool> print-colors: true;

    in property <[MenuEntry]> file-menu;
    in property <[MenuEntry]> file-menu-2;
    in property <[MenuEntry]> file-menu-3;
    in property <[MenuEntry]> recent-menu;
    in property <[MenuEntry]> reopen-menu;
    in property <[MenuEntry]> convert-menu;
    in property <[MenuEntry]> line-ending-menu;
    in property <[MenuEntry]> edit-menu;
    in property <[MenuEntry]> selection-menu;
    in property <[MenuEntry]> find-menu;
    in property <[MenuEntry]> view-menu;
    in property <[MenuEntry]> view-menu-2;
    in property <[MenuEntry]> theme-menu;

    callback command(id: string);
    callback select-doc(index: int);
    callback drag-window();
    callback sidebar-resized(width: length);

    // The search panel leaves the editor some room when the window gets smaller.
    changed height => {
        if SearchBridge.panel-height > self.height - 240px {
            SearchBridge.panel-height = max(150px, self.height - 240px);
        }
    }

    public function focus-editor() {
        editor.focus-editor();
    }

    public function focus-find() {
        find-bar.focus-find();
    }

    MenuBar {
        Menu {
            title: "File";
            for item in root.file-menu: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
            Menu {
                title: "Open Recent";
                enabled: root.recent-menu.length > 0;
                for item in root.recent-menu: MenuItem {
                    title: item.title;
                    enabled: item.enabled;
                    checkable: item.checkable;
                    checked: item.checked;
                    activated => { root.command(item.id); }
                }
            }
            for item in root.file-menu-2: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
            Menu {
                title: "Reopen with Encoding";
                enabled: root.reopen-menu.length > 0;
                for item in root.reopen-menu: MenuItem {
                    title: item.title;
                    enabled: item.enabled;
                    checkable: item.checkable;
                    checked: item.checked;
                    activated => { root.command(item.id); }
                }
            }
            Menu {
                title: "Convert to Encoding";
                enabled: root.convert-menu.length > 0;
                for item in root.convert-menu: MenuItem {
                    title: item.title;
                    enabled: item.enabled;
                    checkable: item.checkable;
                    checked: item.checked;
                    activated => { root.command(item.id); }
                }
            }
            Menu {
                title: "Line Endings";
                enabled: root.line-ending-menu.length > 0;
                for item in root.line-ending-menu: MenuItem {
                    title: item.title;
                    enabled: item.enabled;
                    checkable: item.checkable;
                    checked: item.checked;
                    activated => { root.command(item.id); }
                }
            }
            for item in root.file-menu-3: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
        }
        Menu {
            title: "Edit";
            for item in root.edit-menu: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
        }
        Menu {
            title: "Selection";
            for item in root.selection-menu: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
        }
        Menu {
            title: "Find";
            for item in root.find-menu: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
        }
        Menu {
            title: "View";
            for item in root.view-menu: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
            Menu {
                title: "Theme";
                for item in root.theme-menu: MenuItem {
                    title: item.title;
                    checkable: item.checkable;
                    checked: item.checked;
                    activated => { root.command(item.id); }
                }
            }
            for item in root.view-menu-2: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                checkable: item.checkable;
                checked: item.checked;
                activated => { root.command(item.id); }
            }
        }
    }

    HorizontalLayout {
        sidebar := Sidebar {
            width: root.sidebar-visible ? root.sidebar-width : 0px;
            animate width { duration: self.resizing ? 0ms : 180ms; easing: ease-in-out; }
            docs: root.docs;
            current: root.current-doc;
            top-inset: root.titlebar-height;
            select(index) => {
                root.select-doc(index);
                editor.focus-editor();
            }
            toggle-sidebar => { root.command("view.sidebar"); }
            toggle-theme => {
                root.command("view.toggle-theme");
                editor.focus-editor();
            }
            drag-window => { root.drag-window(); }
            resize(width) => { root.sidebar-resized(width); }
        }

        VerticalLayout {
            Rectangle {
                height: root.titlebar-height > 0 ? 52px : 44px;
                background: Theme.header-background;

                TouchArea {
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down { root.drag-window(); }
                    }
                }

                HorizontalLayout {
                    // Clear the window buttons when the sidebar is hidden.
                    padding-left: !root.sidebar-visible && root.titlebar-height > 0 ? 84px : 16px;
                    padding-right: 12px;
                    spacing: 8px;
                    animate padding-left { duration: 180ms; easing: ease-in-out; }

                    if !root.sidebar-visible: VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: Icons.sidebar;
                            clicked => { root.command("view.sidebar"); }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        padding-left: 6px;
                        Text {
                            text: root.doc-title;
                            font-size: 13.5px;
                            font-weight: 650;
                            color: Theme.primary-text;
                            overflow: elide;
                        }
                        Text {
                            text: root.doc-subtitle;
                            font-size: 11px;
                            color: Theme.secondary-text;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 2px;
                            IconButton {
                                icon: Icons.wrap;
                                on: root.wraps;
                                clicked => {
                                    root.command("view.wrap");
                                    editor.focus-editor();
                                }
                            }
                            IconButton {
                                icon: Icons.plus;
                                clicked => {
                                    root.command("file.new");
                                    editor.focus-editor();
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.separator;
                }
            }

            Rectangle {
                height: root.banner == 0 ? 0px : 44px;
                clip: true;
                animate height { duration: 160ms; easing: ease-out; }
                background: Theme.dark ? #FFB0400F : #C2410C0D;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 14px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Path {
                            width: 16px;
                            height: 16px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: Icons.alert;
                            fill: transparent;
                            stroke: Theme.dark ? #F2B36D : #B4441B;
                            stroke-width: 1.8px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                        }
                    }
                    Text {
                        text: root.banner-text;
                        font-size: 12.5px;
                        color: Theme.primary-text;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            if root.banner == 1: PillButton {
                                text: "Keep Mine";
                                clicked => { root.command("disk.keep"); }
                            }
                            if root.banner == 1: PillButton {
                                text: "Reload";
                                primary: true;
                                clicked => { root.command("disk.reload"); }
                            }
                            if root.banner == 2: PillButton {
                                text: "Close";
                                clicked => { root.command("file.close"); }
                            }
                            if root.banner == 2: PillButton {
                                text: "Save Again";
                                primary: true;
                                clicked => { root.command("disk.save"); }
                            }
                        }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.separator;
                }
            }

            find-bar := FindBar { }
            if FindBridge.open: Rectangle {
                height: 1px;
                background: Theme.separator;
            }

            editor := EditorView {
                font-family: Theme.mono-family;
                vertical-stretch: 1;
            }

            if SearchBridge.open: SearchPanel {
                height: SearchBridge.panel-height;
                max-panel-height: root.height - 240px;
            }

            Rectangle {
                height: 27px;
                background: Theme.status-background;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.separator;
                }
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    alignment: space-between;
                    Text {
                        text: root.status-left;
                        font-size: 11.5px;
                        color: Theme.secondary-text;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.status-right;
                        font-size: 11.5px;
                        color: Theme.secondary-text;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Files dragged over the window.
    if root.dropping: Rectangle {
        background: Theme.drop-tint;
        border-width: 3px;
        border-color: Theme.dark ? #6F95E8 : Theme.accent.with-alpha(0.6);
        border-radius: 12px;
        Rectangle {
            width: 220px;
            height: 44px;
            border-radius: 22px;
            background: Theme.accent;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000033;
            Text {
                text: "Drop to open";
                color: Theme.accent-text;
                font-size: 14px;
                font-weight: 650;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    if root.print-sheet: Sheet {
        title: "Print “" + root.doc-title + "”";
        accept-title: "Print…";
        accept => { root.command("print.confirm"); }
        cancel => { root.command("print.cancel"); }
        Toggle {
            text: "Line numbers";
            on: root.print-line-numbers;
            toggled(on) => { root.print-line-numbers = on; }
        }
        Toggle {
            text: "Syntax colors";
            on: root.print-colors;
            toggled(on) => { root.print-colors = on; }
        }
    }

    if SearchBridge.plan-open: ReplacePlanSheet { }

    if root.palette-open: CommandPalette {
        items: root.palette-items;
        selected <=> root.palette-selected;
        query-changed(query) => { root.palette-query(query); }
        run(index) => { root.palette-run(index); }
        close => { root.palette-close(); }
    }
}
