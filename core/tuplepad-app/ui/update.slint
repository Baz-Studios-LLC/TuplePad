import { Theme } from "theme.slint";
import { Sheet } from "controls.slint";

// A line of an update's notes: 0 text, 1 heading, 2 list item.
export struct NoteLine {
    kind: int,
    text: string,
}

// Updates: what a check found (Help ▸ Check for Updates…), and an update as it downloads and
// installs. The status bar shows a pill while there's one to install.
export global UpdateBridge {
    in property <bool> open;
    // 0 checking, 1 up to date, 2 available, 3 downloading, 4 installing, 5 failed.
    in property <int> kind;
    in property <string> title;
    in property <string> detail;
    // What's new in the update, line by line.
    in property <[NoteLine]> notes;
    // This copy can replace itself (else the main button opens the release page).
    in property <bool> installable;
    in property <float> progress;
    // The status bar's pill ("Update to v002"), empty when there's nothing to show.
    in property <string> pill;
    callback install();
    callback close();
    callback skip();
    callback cancel();
    callback download();
    callback show();
}

export component UpdateSheet inherits Sheet {
    title: UpdateBridge.title;
    card-width: 480px;
    // "Up to date" needs only OK, and installing can't be stopped.
    show-cancel: UpdateBridge.kind != 1 && UpdateBridge.kind != 4;
    cancel-title: UpdateBridge.kind == 2 ? "Later" : (UpdateBridge.kind == 0 || UpdateBridge.kind == 3) ? "Cancel" : "Close";
    show-accept: UpdateBridge.kind == 1 || UpdateBridge.kind == 2 || UpdateBridge.kind == 5;
    accept-title: UpdateBridge.kind == 1 ? "OK" : UpdateBridge.kind == 5 ? "Open Releases Page" : UpdateBridge.installable ? "Install and Relaunch" : "Download";
    secondary-title: UpdateBridge.kind == 2 ? "Skip This Version" : "";
    accept => {
        if UpdateBridge.kind == 2 {
            UpdateBridge.install();
        } else if UpdateBridge.kind == 5 {
            UpdateBridge.download();
        } else {
            UpdateBridge.close();
        }
    }
    cancel => {
        if UpdateBridge.kind == 3 {
            UpdateBridge.cancel();
        } else if UpdateBridge.kind != 4 {
            UpdateBridge.close();
        }
    }
    secondary => { UpdateBridge.skip(); }

    Text {
        text: UpdateBridge.detail;
        font-size: 12.5px;
        color: Theme.secondary-text;
        wrap: word-wrap;
    }

    // What's new.
    if UpdateBridge.kind == 2 && UpdateBridge.notes.length > 0: Rectangle {
        height: min(notes.preferred-height, 260px);
        border-radius: 8px;
        background: Theme.dark ? #FFFFFF0A : #00000008;
        border-width: 1px;
        border-color: Theme.separator;
        clip: true;
        notes-scroll := Flickable {
            content-height: notes.preferred-height;
            notes := VerticalLayout {
                width: notes-scroll.width;
                padding: 12px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 6px;
                alignment: start;
                for line[index] in UpdateBridge.notes: HorizontalLayout {
                    // A heading after the first gets room above it.
                    padding-top: line.kind == 1 && index > 0 ? 8px : 0px;
                    spacing: 7px;
                    // Layouts measure text on one line; this counts the lines it wraps to.
                    min-height: body.preferred-height + self.padding-top;
                    // List items hang from their bullet.
                    if line.kind == 2: Text {
                        accessible-role: none;
                        width: 6px;
                        text: "•";
                        font-size: 12.5px;
                        color: Theme.secondary-text;
                    }
                    body := Text {
                        horizontal-stretch: 1;
                        text: line.text;
                        font-size: line.kind == 1 ? 11px : 12.5px;
                        font-weight: line.kind == 1 ? 700 : 400;
                        color: line.kind == 1 ? Theme.secondary-text : Theme.primary-text;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    // How far the download has got.
    if UpdateBridge.kind == 3 || UpdateBridge.kind == 4: Rectangle {
        accessible-role: progress-indicator;
        accessible-label: "Download progress";
        accessible-value: Math.round(UpdateBridge.progress * 100) + "%";
        height: 6px;
        border-radius: 3px;
        background: Theme.dark ? #FFFFFF14 : #0000000F;
        Rectangle {
            x: 0;
            width: parent.width * clamp(UpdateBridge.progress, 0, 1);
            border-radius: 3px;
            background: Theme.accent;
            animate width { duration: 150ms; }
        }
    }
}
