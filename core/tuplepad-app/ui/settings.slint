import { Theme, Themes, ThemeColors } from "theme.slint";
import { Toggle, Segmented, Stepper, Dropdown, Section, SettingRow } from "controls.slint";
import { ListView } from "std-widgets.slint";
import { InputField } from "findbar.slint";
import { PillButton } from "sidebar.slint";

// A snippet in the Snippets tab's list.
export struct SnippetRow {
    name: string,
    detail: string,
}

// An AI tool that has asked to use TuplePad (MCP). `access`: 0 read and edit, 1 read only, 2 not allowed.
export struct McpClientRow {
    name: string,
    access: int,
    connected: bool,
}

// A line of the MCP activity log.
export struct McpLogRow {
    time: string,
    client: string,
    tool: string,
    summary: string,
    failed: bool,
}

// A way to connect an AI tool, with a button that copies it.
component ConnectRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> code;
    in property <bool> copied;
    callback copy();
    min-height: 50px;
    spacing: 16px;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        Text {
            text: root.label;
            font-size: 13px;
            color: Theme.primary-text;
        }
        Text {
            text: root.code;
            font-family: Theme.mono-family;
            font-size: 11px;
            color: Theme.secondary-text;
            overflow: elide;
        }
    }
    VerticalLayout {
        alignment: center;
        PillButton {
            text: root.copied ? "Copied" : "Copy";
            clicked => { root.copy(); }
        }
    }
}

// Everything the Settings window shows, set from Rust.
export struct SettingsValues {
    font-names: [string],
    font-index: int,
    font-size: int,
    // 0 compact, 1 normal, 2 relaxed.
    line-height: int,
    tab-width: int,
    use-tabs: bool,
    detect-indentation: bool,
    auto-close: bool,
    smart-highlight: bool,
    wrap: bool,
    invisibles: bool,
    indent-guides: bool,
    current-line: bool,
    minimap: bool,
    word-completion: bool,
    encodings: [string],
    encoding-index: int,
    bom: bool,
    // 0 LF, 1 CRLF, 2 CR.
    line-ending: int,
    // 0 system, 1 light, 2 dark.
    appearance: int,
    theme: int,
    mcp: bool,
    mcp-http: bool,
}

component TabButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    width: 92px;
    height: 54px;
    border-radius: 9px;
    background: root.selected ? Theme.control-hover : touch.has-hover ? Theme.control-hover.with-alpha(0.5) : transparent;
    animate background { duration: 120ms; }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Path {
                width: 20px;
                height: 20px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon;
                fill: transparent;
                stroke: root.selected ? Theme.accent.mix(Theme.primary-text, Theme.dark ? 0.35 : 0.85) : Theme.icon;
                stroke-width: 1.7px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }
        Text {
            text: root.label;
            font-size: 11.5px;
            font-weight: root.selected ? 650 : 500;
            color: root.selected ? Theme.primary-text : Theme.secondary-text;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// A theme, previewed with a few lines of colored code in the current light or dark look.
component ThemeCard inherits Rectangle {
    in property <ThemeColors> colors;
    in property <string> name;
    in property <string> summary;
    in property <bool> selected;
    callback clicked;
    height: 128px;
    border-radius: 12px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent.mix(Theme.primary-text, Theme.dark ? 0.4 : 1.0) : Theme.separator;
    background: Theme.header-background;
    VerticalLayout {
        padding: 8px;
        spacing: 8px;
        Rectangle {
            height: 64px;
            border-radius: 7px;
            background: root.colors.editor-background;
            border-width: 1px;
            border-color: root.colors.separator;
            clip: true;
            VerticalLayout {
                padding: 9px;
                spacing: 5px;
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    Rectangle { width: 22px; height: 6px; border-radius: 3px; background: root.colors.syntax[1]; }
                    Rectangle { width: 34px; height: 6px; border-radius: 3px; background: root.colors.syntax[7]; }
                    Rectangle { width: 18px; height: 6px; border-radius: 3px; background: root.colors.syntax[12]; }
                }
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    Rectangle { width: 8px; height: 6px; }
                    Rectangle { width: 26px; height: 6px; border-radius: 3px; background: root.colors.syntax[8]; }
                    Rectangle { width: 40px; height: 6px; border-radius: 3px; background: root.colors.syntax[2]; }
                }
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    Rectangle { width: 8px; height: 6px; }
                    Rectangle { width: 48px; height: 6px; border-radius: 3px; background: root.colors.syntax[4]; }
                    Rectangle { width: 14px; height: 6px; border-radius: 3px; background: root.colors.syntax[5]; }
                }
            }
            Rectangle {
                x: 0;
                width: 3px;
                y: 22px;
                height: 12px;
                background: root.colors.caret;
            }
        }
        VerticalLayout {
            spacing: 1px;
            Text { text: root.name; font-size: 12.5px; font-weight: 650; color: Theme.primary-text; }
            Text { text: root.summary; font-size: 11px; color: Theme.secondary-text; overflow: elide; }
        }
    }
    TouchArea { clicked => { root.clicked(); } }
}

export component SettingsWindow inherits Window {
    title: "Settings";
    preferred-width: 640px;
    preferred-height: 720px;
    min-width: 560px;
    min-height: 560px;
    background: Theme.sidebar-background;
    default-font-size: Theme.ui-font-size;

    in property <length> titlebar-height: 0px;
    in-out property <int> tab: 0;
    in property <SettingsValues> values;
    in property <string> version;
    // The Snippets tab: the list, and the fields of the one chosen.
    in property <[SnippetRow]> snippets;
    in-out property <int> snippet-index: -1;
    in-out property <string> snippet-trigger;
    in-out property <string> snippet-name;
    in-out property <int> snippet-language;
    in property <[string]> snippet-languages;
    in-out property <string> snippet-body;
    // The AI tab: whether the MCP server runs and how to connect, the AI tools that asked, and what they did.
    in property <string> mcp-status;
    in property <string> mcp-http-detail;
    in property <string> mcp-command;
    in property <string> mcp-json;
    in property <string> mcp-url;
    in property <[McpClientRow]> mcp-clients;
    in property <[McpLogRow]> mcp-log;
    // Which copy button was just used ("command", "json" or "url").
    in property <string> copied;
    callback mcp-client-access(name: string, access: int);
    callback mcp-client-forget(name: string);
    callback copy-text(what: string);
    callback snippet-select(index: int);
    callback snippet-edited();
    callback snippet-add();
    callback snippet-remove();
    callback set-bool(key: string, value: bool);
    callback set-int(key: string, value: int);
    callback drag-window();

    VerticalLayout {
        Rectangle {
            height: root.titlebar-height + 68px;
            TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down { root.drag-window(); }
                }
            }
            HorizontalLayout {
                padding-top: root.titlebar-height;
                alignment: center;
                spacing: 4px;
                TabButton {
                    icon: "M4 7h9 M17 7h3 M4 17h3 M11 17h9 M15 4.5v5 M9 14.5v5";
                    label: "General";
                    selected: root.tab == 0;
                    clicked => { root.tab = 0; }
                }
                TabButton {
                    icon: "M5 5.5h14 M12 5.5v13 M9 18.5h6";
                    label: "Editor";
                    selected: root.tab == 1;
                    clicked => { root.tab = 1; }
                }
                TabButton {
                    icon: "M12 3.5a8.5 8.5 0 1 0 0 17a8.5 8.5 0 1 0 0-17z M12 3.5v17 M12 8h6.5 M12 12.5h8.5 M12 17h6.5";
                    label: "Appearance";
                    selected: root.tab == 2;
                    clicked => { root.tab = 2; }
                }
                TabButton {
                    icon: "M8 6l-5 6 5 6 M16 6l5 6-5 6 M13.5 4.5l-3 15";
                    label: "Snippets";
                    selected: root.tab == 3;
                    clicked => { root.tab = 3; }
                }
                TabButton {
                    icon: "M11 3.5l1.9 5.1 5.1 1.9-5.1 1.9L11 17.5l-1.9-5.1L4 10.5l5.1-1.9z M18 15l.8 2.2 2.2.8-2.2.8L18 21l-.8-2.2L15 18l2.2-.8z";
                    label: "AI";
                    selected: root.tab == 4;
                    clicked => { root.tab = 4; }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.separator;
            }
        }

        Rectangle {
            background: Theme.header-background;
            vertical-stretch: 1;

            if root.tab == 0: VerticalLayout {
                padding: 24px;
                spacing: 20px;
                alignment: start;
                Section {
                    title: "NEW DOCUMENTS";
                    SettingRow {
                        label: "Encoding";
                        Dropdown {
                            options: root.values.encodings;
                            selected: root.values.encoding-index;
                            chosen(index) => { root.set-int("encoding", index); }
                        }
                    }
                    SettingRow {
                        label: "Byte order mark";
                        detail: "Only for Unicode encodings";
                        Toggle { on: root.values.bom; toggled(on) => { root.set-bool("bom", on); } }
                    }
                    SettingRow {
                        label: "Line endings";
                        Segmented {
                            options: ["LF", "CRLF", "CR"];
                            selected: root.values.line-ending;
                            chosen(index) => { root.set-int("line-ending", index); }
                        }
                    }
                }
                Section {
                    title: "INDENTATION";
                    SettingRow {
                        label: "Indent with";
                        Segmented {
                            options: ["Spaces", "Tabs"];
                            selected: root.values.use-tabs ? 1 : 0;
                            chosen(index) => { root.set-bool("use-tabs", index == 1); }
                        }
                    }
                    SettingRow {
                        label: "Tab width";
                        Stepper {
                            value: root.values.tab-width;
                            minimum: 1;
                            maximum: 16;
                            suffix: root.values.tab-width == 1 ? " space" : " spaces";
                            changed(value) => { root.set-int("tab-width", value); }
                        }
                    }
                    SettingRow {
                        label: "Detect indentation";
                        detail: "Use whatever each file already uses";
                        Toggle { on: root.values.detect-indentation; toggled(on) => { root.set-bool("detect-indentation", on); } }
                    }
                }
                Section {
                    title: "TYPING";
                    SettingRow {
                        label: "Close brackets and quotes";
                        Toggle { on: root.values.auto-close; toggled(on) => { root.set-bool("auto-close", on); } }
                    }
                    SettingRow {
                        label: "Highlight other occurrences";
                        detail: "Of the selected text, or the word at the caret";
                        Toggle { on: root.values.smart-highlight; toggled(on) => { root.set-bool("smart-highlight", on); } }
                    }
                    SettingRow {
                        label: "Suggest words";
                        detail: "Finish words from the open documents (Tab or Return)";
                        Toggle { on: root.values.word-completion; toggled(on) => { root.set-bool("word-completion", on); } }
                    }
                }
            }

            if root.tab == 1: VerticalLayout {
                padding: 24px;
                spacing: 20px;
                alignment: start;
                Section {
                    title: "FONT";
                    SettingRow {
                        label: "Font";
                        Dropdown {
                            width: 220px;
                            options: root.values.font-names;
                            selected: root.values.font-index;
                            list-height: 320px;
                            chosen(index) => { root.set-int("font", index); }
                        }
                    }
                    SettingRow {
                        label: "Size";
                        Stepper {
                            value: root.values.font-size;
                            minimum: 8;
                            maximum: 48;
                            suffix: " pt";
                            changed(value) => { root.set-int("font-size", value); }
                        }
                    }
                    SettingRow {
                        label: "Line height";
                        Segmented {
                            options: ["Compact", "Normal", "Relaxed"];
                            selected: root.values.line-height;
                            chosen(index) => { root.set-int("line-height", index); }
                        }
                    }
                }
                Rectangle {
                    height: 92px;
                    border-radius: 10px;
                    background: Theme.editor-background;
                    border-width: 1px;
                    border-color: Theme.separator;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 0px;
                        HorizontalLayout {
                            alignment: start;
                            Text { text: "fn "; color: Theme.syntax[1]; font-family: Theme.mono-family; font-size: root.values.font-size * 1px; }
                            Text { text: "greet"; color: Theme.syntax[7]; font-family: Theme.mono-family; font-size: root.values.font-size * 1px; }
                            Text { text: "(name: "; color: Theme.text; font-family: Theme.mono-family; font-size: root.values.font-size * 1px; }
                            Text { text: "&str"; color: Theme.syntax[8]; font-family: Theme.mono-family; font-size: root.values.font-size * 1px; }
                            Text { text: ") {"; color: Theme.text; font-family: Theme.mono-family; font-size: root.values.font-size * 1px; }
                        }
                        HorizontalLayout {
                            alignment: start;
                            Text { text: "    println!("; color: Theme.syntax[7]; font-family: Theme.mono-family; font-size: root.values.font-size * 1px; }
                            Text { text: "\"Hello, {name}! 👋\""; color: Theme.syntax[2]; font-family: Theme.mono-family; font-size: root.values.font-size * 1px; }
                            Text { text: ");"; color: Theme.text; font-family: Theme.mono-family; font-size: root.values.font-size * 1px; }
                        }
                        HorizontalLayout {
                            alignment: start;
                            Text { text: "}"; color: Theme.text; font-family: Theme.mono-family; font-size: root.values.font-size * 1px; }
                            Text { text: "  // 0O 1lI {[()]}"; color: Theme.syntax[4]; font-family: Theme.mono-family; font-size: root.values.font-size * 1px; }
                        }
                    }
                }
                Section {
                    title: "DISPLAY";
                    SettingRow {
                        label: "Wrap lines in new documents";
                        Toggle { on: root.values.wrap; toggled(on) => { root.set-bool("wrap", on); } }
                    }
                    SettingRow {
                        label: "Show invisibles";
                        Toggle { on: root.values.invisibles; toggled(on) => { root.set-bool("invisibles", on); } }
                    }
                    SettingRow {
                        label: "Show indent guides";
                        Toggle { on: root.values.indent-guides; toggled(on) => { root.set-bool("indent-guides", on); } }
                    }
                    SettingRow {
                        label: "Highlight the current line";
                        Toggle { on: root.values.current-line; toggled(on) => { root.set-bool("current-line", on); } }
                    }
                    SettingRow {
                        label: "Show minimap";
                        Toggle { on: root.values.minimap; toggled(on) => { root.set-bool("minimap", on); } }
                    }
                }
            }

            if root.tab == 3: HorizontalLayout {
                padding: 24px;
                padding-bottom: 44px;
                spacing: 18px;
                VerticalLayout {
                    width: 230px;
                    spacing: 10px;
                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: 10px;
                        background: Theme.editor-background;
                        border-width: 1px;
                        border-color: Theme.separator;
                        clip: true;
                        ListView {
                            for snippet[index] in root.snippets: Rectangle {
                                height: 46px;
                                Rectangle {
                                    x: 4px;
                                    y: 2px;
                                    width: parent.width - 8px;
                                    height: parent.height - 4px;
                                    border-radius: 7px;
                                    background: index == root.snippet-index ? Theme.selected-row : row-touch.has-hover ? Theme.sidebar-hover : transparent;
                                }
                                VerticalLayout {
                                    padding-left: 14px;
                                    padding-right: 12px;
                                    alignment: center;
                                    Text {
                                        text: snippet.name;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: index == root.snippet-index ? Theme.selected-row-text : Theme.primary-text;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: snippet.detail;
                                        font-size: 11px;
                                        color: index == root.snippet-index ? Theme.selected-row-detail : Theme.secondary-text;
                                        overflow: elide;
                                    }
                                }
                                row-touch := TouchArea {
                                    clicked => { root.snippet-select(index); }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        PillButton {
                            text: "Add";
                            clicked => { root.snippet-add(); }
                        }
                        PillButton {
                            text: "Remove";
                            opacity: root.snippet-index >= 0 ? 1 : 0.45;
                            clicked => {
                                if root.snippet-index >= 0 { root.snippet-remove(); }
                            }
                        }
                    }
                }
                if root.snippet-index < 0: Text {
                    horizontal-stretch: 1;
                    text: "Choose a snippet to change it, or add one.";
                    font-size: 13px;
                    color: Theme.tertiary-text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if root.snippet-index >= 0: VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 14px;
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 5px;
                            width: 150px;
                            Text { text: "TRIGGER"; font-size: 11px; font-weight: 600; color: Theme.secondary-text; }
                            InputField {
                                text <=> root.snippet-trigger;
                                mono: true;
                                placeholder: "fn";
                                edited => { root.snippet-edited(); }
                            }
                        }
                        VerticalLayout {
                            spacing: 5px;
                            Text { text: "NAME"; font-size: 11px; font-weight: 600; color: Theme.secondary-text; }
                            InputField {
                                text <=> root.snippet-name;
                                placeholder: "Function";
                                edited => { root.snippet-edited(); }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 5px;
                        Text { text: "LANGUAGE"; font-size: 11px; font-weight: 600; color: Theme.secondary-text; }
                        Dropdown {
                            options: root.snippet-languages;
                            selected: root.snippet-language;
                            list-height: 300px;
                            chosen(index) => {
                                root.snippet-language = index;
                                root.snippet-edited();
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 5px;
                        vertical-stretch: 1;
                        Text { text: "TEXT"; font-size: 11px; font-weight: 600; color: Theme.secondary-text; }
                        Rectangle {
                            vertical-stretch: 1;
                            min-height: 120px;
                            border-radius: 8px;
                            background: Theme.editor-background;
                            border-width: 1px;
                            border-color: body.has-focus ? Theme.accent.with-alpha(0.6) : Theme.control-border;
                            clip: true;
                            body := TextInput {
                                x: 10px;
                                y: 8px;
                                width: parent.width - 20px;
                                height: parent.height - 16px;
                                text <=> root.snippet-body;
                                single-line: false;
                                wrap: word-wrap;
                                font-family: Theme.mono-family;
                                font-size: 12.5px;
                                color: Theme.primary-text;
                                selection-background-color: Theme.selection;
                                edited => { root.snippet-edited(); }
                            }
                        }
                        Text {
                            text: "Type the trigger and press Tab to insert. $1, $2… are places Tab moves to next, ${1:text} starts with text there, and $0 is where it ends.";
                            font-size: 11px;
                            color: Theme.secondary-text;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if root.tab == 4: VerticalLayout {
                padding: 24px;
                // Room for the version at the bottom.
                padding-bottom: 44px;
                spacing: 20px;
                Section {
                    title: "MCP SERVER";
                    SettingRow {
                        label: "Let AI tools use TuplePad";
                        detail: root.mcp-status;
                        Toggle { on: root.values.mcp; toggled(on) => { root.set-bool("mcp", on); } }
                    }
                    SettingRow {
                        label: "Also over HTTP";
                        detail: root.mcp-http-detail;
                        Toggle { on: root.values.mcp-http; toggled(on) => { root.set-bool("mcp-http", on); } }
                    }
                }
                if root.values.mcp: Section {
                    title: "CONNECT AN AI TOOL";
                    ConnectRow {
                        label: "Claude Code";
                        code: root.mcp-command;
                        copied: root.copied == "command";
                        copy => { root.copy-text("command"); }
                    }
                    ConnectRow {
                        label: "Claude Desktop and other apps";
                        code: root.mcp-json;
                        copied: root.copied == "json";
                        copy => { root.copy-text("json"); }
                    }
                    if root.mcp-url != "": ConnectRow {
                        label: "Over HTTP";
                        code: root.mcp-url;
                        copied: root.copied == "url";
                        copy => { root.copy-text("url"); }
                    }
                }
                Section {
                    title: "AI TOOLS";
                    if root.mcp-clients.length == 0: Text {
                        height: 42px;
                        text: "None yet. TuplePad asks you the first time an AI tool wants your documents.";
                        font-size: 12px;
                        color: Theme.secondary-text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    for client in root.mcp-clients: SettingRow {
                        label: client.name;
                        detail: client.connected ? "Connected now" : "";
                        HorizontalLayout {
                            spacing: 8px;
                            Dropdown {
                                options: ["Read and edit", "Read only", "Not allowed"];
                                selected: client.access;
                                list-height: 120px;
                                chosen(index) => { root.mcp-client-access(client.name, index); }
                            }
                            PillButton {
                                text: "Forget";
                                clicked => { root.mcp-client-forget(client.name); }
                            }
                        }
                    }
                }
                VerticalLayout {
                    spacing: 6px;
                    vertical-stretch: 1;
                    Text {
                        text: "ACTIVITY";
                        font-size: 11px;
                        font-weight: 650;
                        letter-spacing: 0.4px;
                        color: Theme.secondary-text;
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 90px;
                        border-radius: 10px;
                        background: Theme.dark ? #FFFFFF08 : #00000005;
                        border-width: 1px;
                        border-color: Theme.separator;
                        clip: true;
                        if root.mcp-log.length == 0: Text {
                            text: "What AI tools read and change shows up here.";
                            font-size: 12px;
                            color: Theme.tertiary-text;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        ListView {
                            for entry in root.mcp-log: HorizontalLayout {
                                height: 26px;
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 10px;
                                Text {
                                    width: 58px;
                                    text: entry.time;
                                    font-family: Theme.mono-family;
                                    font-size: 11px;
                                    color: Theme.tertiary-text;
                                    vertical-alignment: center;
                                }
                                Text {
                                    width: 100px;
                                    text: entry.client;
                                    font-size: 12px;
                                    color: Theme.secondary-text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    width: 118px;
                                    text: entry.tool;
                                    font-family: Theme.mono-family;
                                    font-size: 11px;
                                    color: Theme.primary-text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: entry.summary;
                                    font-size: 12px;
                                    color: entry.failed ? Theme.syntax[23] : Theme.secondary-text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }

            if root.tab == 2: VerticalLayout {
                padding: 24px;
                spacing: 20px;
                alignment: start;
                Section {
                    SettingRow {
                        label: "Appearance";
                        Segmented {
                            options: ["System", "Light", "Dark"];
                            selected: root.values.appearance;
                            chosen(index) => { root.set-int("appearance", index); }
                        }
                    }
                }
                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "THEME";
                        font-size: 11px;
                        font-weight: 650;
                        letter-spacing: 0.4px;
                        color: Theme.secondary-text;
                    }
                    GridLayout {
                        spacing: 12px;
                        Row {
                            for i in [0, 1, 2]: ThemeCard {
                                colors: Theme.dark ? Themes.darks[i] : Themes.lights[i];
                                name: Themes.names[i];
                                summary: Themes.summaries[i];
                                selected: root.values.theme == i;
                                clicked => { root.set-int("theme", i); }
                            }
                        }
                        Row {
                            for i in [3, 4]: ThemeCard {
                                colors: Theme.dark ? Themes.darks[i] : Themes.lights[i];
                                name: Themes.names[i];
                                summary: Themes.summaries[i];
                                selected: root.values.theme == i;
                                clicked => { root.set-int("theme", i); }
                            }
                        }
                    }
                }
            }
        }
    }

    // Which TuplePad this is.
    Text {
        x: 24px;
        y: root.height - 30px;
        text: "TuplePad " + root.version;
        font-size: 11px;
        color: Theme.tertiary-text;
    }
}
