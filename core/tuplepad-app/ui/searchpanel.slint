import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PillButton } from "sidebar.slint";
import { Segmented, Toggle } from "controls.slint";
import { SmallButton, InputField } from "findbar.slint";
import { TitlePart } from "palette.slint";

// One row of the results: a file, or a matching line in it.
export struct SearchRow {
    // 0 a file, 1 a matching line.
    kind: int,
    // A file's name, or (for a line) nothing.
    title: string,
    // A file's folder.
    location: string,
    // A file's match count, or a line's number.
    count: string,
    // A line's text, with the matches marked.
    parts: [TitlePart],
    collapsed: bool,
}

// One row of the Replace in Files preview: a file (with a checkbox), or a stretch of lines.
export struct PlanRow {
    kind: int,
    title: string,
    location: string,
    count: string,
    included: bool,
    line: string,
    before: string,
    after: string,
    // One-line changes, with the changed text marked.
    before-parts: [TitlePart],
    after-parts: [TitlePart],
    // Lines in the taller of `before` and `after`.
    lines: int,
}

// A file Replace in Files changed, with its Undo.
export struct ReplacedRow {
    title: string,
    location: string,
    count: string,
    undone: bool,
    error: string,
}

// Find and Replace across open documents or a folder, shared with Rust.
export global SearchBridge {
    in-out property <bool> open;
    // 0 open documents, 1 a folder.
    in-out property <int> scope: 1;
    in-out property <string> query;
    in-out property <string> replacement;
    in-out property <bool> case-sensitive;
    in-out property <bool> whole-word;
    in-out property <bool> regex;
    in-out property <bool> show-replace;
    in-out property <string> include;
    in-out property <string> exclude;
    in-out property <bool> search-everything;
    // The folder, for display.
    in property <string> folder;
    in property <[string]> recent-folders;
    in property <bool> searching;
    in property <bool> preparing;
    in property <string> status;
    in property <bool> error;
    in property <string> skipped;
    in property <[SearchRow]> rows;
    in-out property <int> selected: -1;
    in property <[ReplacedRow]> replaced;
    in property <bool> plan-open;
    in property <[PlanRow]> plan;
    in property <string> plan-title;
    in property <string> plan-summary;
    in property <int> focus-request;
    in-out property <length> panel-height: 340px;

    callback start();
    callback stop();
    callback close();
    callback scope-changed();
    callback choose-folder();
    callback pick-folder(index: int);
    // A row was chosen: `how` is 0 with the arrow keys, 1 by a click, 2 to open it (Return or a
    // double-click, which also gives the editor the keyboard).
    callback activate(index: int, how: int);
    callback prepare-replace();
    callback apply-plan();
    callback cancel-plan();
    callback plan-toggle(index: int);
    callback undo(index: int);
    callback undo-all();
    callback resized();
}

component Chevron inherits Path {
    in property <bool> open;
    width: 10px;
    height: 10px;
    viewbox-width: 10;
    viewbox-height: 10;
    commands: root.open ? "M2 3.5l3 3 3-3" : "M3.5 2l3 3-3 3";
    fill: transparent;
    stroke-width: 1.6px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

component Checkbox inherits Rectangle {
    in property <bool> checked;
    callback toggled();
    width: 16px;
    height: 16px;
    border-radius: 4px;
    background: root.checked ? Theme.accent : transparent;
    border-width: root.checked ? 0px : 1.5px;
    border-color: Theme.control-border;
    if root.checked: Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M2 5.2l2 2 4-4.4";
        fill: transparent;
        stroke: Theme.accent-text;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    TouchArea { clicked => { root.toggled(); } }
}

// Text with some parts highlighted, like a search result's line.
component MarkedLine inherits HorizontalLayout {
    in property <[TitlePart]> parts;
    in property <color> color;
    in property <color> mark;
    spacing: 0px;
    for part in root.parts: Rectangle {
        width: label.preferred-width;
        border-radius: 3px;
        background: part.matched ? root.mark : transparent;
        label := Text {
            text: part.text;
            font-family: Theme.mono-family;
            font-size: 12px;
            color: root.color;
            vertical-alignment: center;
        }
    }
}

component ResultRow inherits Rectangle {
    in property <SearchRow> item;
    in property <bool> selected;
    in property <bool> active;
    callback clicked();
    callback double-clicked();
    height: 26px;
    clip: true;
    property <color> text-color: root.selected && root.active ? Theme.selected-row-text : Theme.primary-text;

    Rectangle {
        x: 6px;
        width: parent.width - 12px;
        border-radius: 6px;
        background: root.selected ? (root.active ? Theme.selected-row : Theme.control-hover) : touch.has-hover ? Theme.sidebar-hover : transparent;
    }

    if root.item.kind == 0: HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Chevron {
                open: !root.item.collapsed;
                stroke: root.selected && root.active ? Theme.selected-row-text : Theme.secondary-text;
            }
        }
        Text {
            text: root.item.title;
            font-size: 13px;
            font-weight: 650;
            color: root.text-color;
            vertical-alignment: center;
        }
        Text {
            text: root.item.location;
            font-size: 12px;
            color: root.selected && root.active ? Theme.selected-row-detail : Theme.secondary-text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 18px;
                width: count.preferred-width + 14px;
                border-radius: 9px;
                background: root.selected && root.active ? Theme.selected-row-text.with-alpha(0.2) : Theme.control-hover;
                count := Text {
                    text: root.item.count;
                    font-size: 11px;
                    font-weight: 600;
                    color: root.selected && root.active ? Theme.selected-row-text : Theme.secondary-text;
                }
            }
        }
    }

    if root.item.kind == 1: HorizontalLayout {
        padding-left: 30px;
        padding-right: 16px;
        spacing: 12px;
        Text {
            width: 44px;
            text: root.item.count;
            font-family: Theme.mono-family;
            font-size: 11px;
            color: root.selected && root.active ? Theme.selected-row-detail : Theme.tertiary-text;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        MarkedLine {
            parts: root.item.parts;
            color: root.text-color;
            mark: root.selected && root.active ? Theme.selected-row-text.with-alpha(0.25) : Theme.find-match;
        }
        Rectangle { horizontal-stretch: 1; }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
    }
}

component ReplacedList inherits Rectangle {
    background: Theme.editor-background;
    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 4px;
            height: 30px;
            Text {
                text: "Changed files";
                font-size: 12px;
                font-weight: 650;
                color: Theme.secondary-text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            PillButton {
                text: "Undo All";
                clicked => { SearchBridge.undo-all(); }
            }
        }
        ListView {
            for file[index] in SearchBridge.replaced: Rectangle {
                height: 34px;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 4px;
                    spacing: 8px;
                    Text {
                        text: file.title;
                        font-size: 13px;
                        font-weight: 600;
                        color: file.undone ? Theme.tertiary-text : Theme.primary-text;
                        vertical-alignment: center;
                    }
                    Text {
                        text: file.error != "" ? file.error : file.undone ? "Undone" : file.location;
                        font-size: 12px;
                        color: file.error != "" ? (Theme.dark ? #FF8F8F : #C0392B) : Theme.secondary-text;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: file.count;
                        font-size: 12px;
                        color: Theme.secondary-text;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        PillButton {
                            text: "Undo";
                            opacity: file.undone ? 0.4 : 1;
                            clicked => {
                                if !file.undone { SearchBridge.undo(index); }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component SearchPanel inherits Rectangle {
    // How tall dragging the divider may make it.
    in property <length> max-panel-height: 600px;
    background: Theme.editor-background;

    public function focus-query() {
        query-field.focus-field();
    }

    property <int> focus-request: SearchBridge.focus-request;
    changed focus-request => { query-field.focus-field(); }
    init => { query-field.focus-field(); }

    VerticalLayout {
        // The divider above the panel; drag it to resize.
        Rectangle {
            height: 1px;
            background: Theme.separator;
            TouchArea {
                y: -4px;
                height: 9px;
                mouse-cursor: row-resize;
                moved => {
                    if self.pressed {
                        SearchBridge.panel-height = max(150px, min(root.max-panel-height, SearchBridge.panel-height - (self.mouse-y - self.pressed-y)));
                    }
                }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.up { SearchBridge.resized(); }
                }
            }
        }

        // The controls.
        Rectangle {
            background: Theme.header-background;
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 8px;

                HorizontalLayout {
                    height: 28px;
                    spacing: 10px;
                    Segmented {
                        width: 236px;
                        options: ["Open Documents", "Folder"];
                        selected: SearchBridge.scope;
                        chosen(index) => {
                            SearchBridge.scope = index;
                            SearchBridge.scope-changed();
                        }
                    }
                    if SearchBridge.scope == 1: folder-button := Rectangle {
                        min-width: 120px;
                        max-width: 360px;
                        horizontal-stretch: 1;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.control-border;
                        background: folder-touch.has-hover ? Theme.control-hover : transparent;
                        HorizontalLayout {
                            padding-left: 9px;
                            padding-right: 9px;
                            spacing: 7px;
                            Path {
                                width: 14px;
                                height: 14px;
                                y: (parent.height - self.height) / 2;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: "M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z";
                                fill: transparent;
                                stroke: Theme.icon;
                                stroke-width: 1.8px;
                                stroke-line-join: round;
                            }
                            Text {
                                text: SearchBridge.folder != "" ? SearchBridge.folder : "Choose Folder…";
                                font-size: 12.5px;
                                color: SearchBridge.folder != "" ? Theme.primary-text : Theme.secondary-text;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Path {
                                width: 10px;
                                height: 10px;
                                y: (parent.height - self.height) / 2;
                                viewbox-width: 10;
                                viewbox-height: 10;
                                commands: "M2 3.5l3 3 3-3";
                                fill: transparent;
                                stroke: Theme.secondary-text;
                                stroke-width: 1.5px;
                                stroke-line-cap: round;
                                stroke-line-join: round;
                            }
                        }
                        folder-touch := TouchArea {
                            clicked => {
                                if SearchBridge.recent-folders.length == 0 {
                                    SearchBridge.choose-folder();
                                } else {
                                    folder-menu.show();
                                }
                            }
                        }
                        folder-menu := PopupWindow {
                            x: 0;
                            y: parent.height + 4px;
                            width: max(parent.width, 280px);
                            Rectangle {
                                border-radius: 10px;
                                background: Theme.header-background;
                                border-width: 1px;
                                border-color: Theme.separator;
                                drop-shadow-blur: 18px;
                                drop-shadow-offset-y: 6px;
                                drop-shadow-color: #00000040;
                                VerticalLayout {
                                    padding: 6px;
                                    for folder[index] in SearchBridge.recent-folders: Rectangle {
                                        height: 28px;
                                        border-radius: 6px;
                                        background: recent-touch.has-hover ? Theme.accent : transparent;
                                        Text {
                                            x: 10px;
                                            width: parent.width - 20px;
                                            text: folder;
                                            font-size: 13px;
                                            color: recent-touch.has-hover ? Theme.accent-text : Theme.primary-text;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        recent-touch := TouchArea {
                                            clicked => {
                                                SearchBridge.pick-folder(index);
                                                folder-menu.close();
                                            }
                                        }
                                    }
                                    Rectangle {
                                        height: 9px;
                                        Rectangle {
                                            height: 1px;
                                            background: Theme.separator;
                                        }
                                    }
                                    Rectangle {
                                        height: 28px;
                                        border-radius: 6px;
                                        background: choose-touch.has-hover ? Theme.accent : transparent;
                                        Text {
                                            x: 10px;
                                            text: "Choose Folder…";
                                            font-size: 13px;
                                            color: choose-touch.has-hover ? Theme.accent-text : Theme.primary-text;
                                            vertical-alignment: center;
                                        }
                                        choose-touch := TouchArea {
                                            clicked => {
                                                SearchBridge.choose-folder();
                                                folder-menu.close();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: SearchBridge.scope == 1 ? 0.2 : 1; }
                    if SearchBridge.searching: VerticalLayout {
                        alignment: center;
                        Path {
                            width: 14px;
                            height: 14px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M12 3a9 9 0 1 1-9 9";
                            fill: transparent;
                            stroke: Theme.accent.with-alpha(Theme.dark ? 0.9 : 0.75);
                            stroke-width: 2.6px;
                            stroke-line-cap: round;
                            transform-rotation: mod(animation-tick() / 1ms, 900) / 900 * 360deg;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: SearchBridge.status;
                            font-size: 12px;
                            color: SearchBridge.error ? (Theme.dark ? #FF8F8F : #C0392B) : Theme.secondary-text;
                            horizontal-alignment: right;
                            overflow: elide;
                        }
                        if SearchBridge.skipped != "": Text {
                            text: SearchBridge.skipped;
                            font-size: 10.5px;
                            color: Theme.tertiary-text;
                            horizontal-alignment: right;
                        }
                    }
                    SmallButton {
                        icon: "M6 6l12 12 M18 6L6 18";
                        clicked => { SearchBridge.close(); }
                    }
                }

                HorizontalLayout {
                    height: 30px;
                    spacing: 6px;
                    SmallButton {
                        y: 1px;
                        icon: SearchBridge.show-replace ? "M6 9l6 6 6-6" : "M9 6l6 6-6 6";
                        clicked => { SearchBridge.show-replace = !SearchBridge.show-replace; }
                    }
                    query-field := InputField {
                        horizontal-stretch: 1;
                        text <=> SearchBridge.query;
                        placeholder: SearchBridge.scope == 1 ? "Find in folder" : "Find in open documents";
                        accepted => { SearchBridge.start(); }
                        escaped => { SearchBridge.close(); }
                        arrow-down => { return root.enter-results(); }
                    }
                    SmallButton { y: 1px; label: "Aa"; on: SearchBridge.case-sensitive; clicked => { SearchBridge.case-sensitive = !SearchBridge.case-sensitive; } }
                    SmallButton { y: 1px; label: "W"; on: SearchBridge.whole-word; clicked => { SearchBridge.whole-word = !SearchBridge.whole-word; } }
                    SmallButton { y: 1px; label: ".*"; on: SearchBridge.regex; clicked => { SearchBridge.regex = !SearchBridge.regex; } }
                    Rectangle { width: 2px; }
                    if !SearchBridge.searching: PillButton {
                        y: 1px;
                        text: "Find All";
                        primary: true;
                        clicked => { SearchBridge.start(); }
                    }
                    if SearchBridge.searching: PillButton {
                        y: 1px;
                        text: "Stop";
                        clicked => { SearchBridge.stop(); }
                    }
                }

                if SearchBridge.show-replace: HorizontalLayout {
                    height: 30px;
                    spacing: 6px;
                    Rectangle { width: 28px; }
                    InputField {
                        horizontal-stretch: 1;
                        text <=> SearchBridge.replacement;
                        placeholder: SearchBridge.regex ? "Replace ($1 for groups)" : "Replace";
                        accepted => { SearchBridge.prepare-replace(); }
                        escaped => { SearchBridge.close(); }
                    }
                    PillButton {
                        y: 1px;
                        text: SearchBridge.preparing ? "Preparing…" : "Replace…";
                        opacity: SearchBridge.rows.length > 0 && !SearchBridge.searching ? 1 : 0.45;
                        clicked => {
                            if SearchBridge.rows.length > 0 && !SearchBridge.searching && !SearchBridge.preparing {
                                SearchBridge.prepare-replace();
                            }
                        }
                    }
                }

                if SearchBridge.scope == 1: HorizontalLayout {
                    height: 30px;
                    spacing: 6px;
                    Rectangle { width: 28px; }
                    InputField {
                        horizontal-stretch: 1;
                        text <=> SearchBridge.include;
                        placeholder: "Include files, like *.rs, *.py";
                        accepted => { SearchBridge.start(); }
                        escaped => { SearchBridge.close(); }
                    }
                    InputField {
                        horizontal-stretch: 1;
                        text <=> SearchBridge.exclude;
                        placeholder: "Exclude, like build, *.min.js";
                        accepted => { SearchBridge.start(); }
                        escaped => { SearchBridge.close(); }
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            text: "Ignored files";
                            on: SearchBridge.search-everything;
                            toggled(on) => { SearchBridge.search-everything = on; }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.separator;
        }

        // The results, or what was replaced.
        list-keys := FocusScope {
            vertical-stretch: 1;
            key-pressed(event) => {
                if SearchBridge.replaced.length > 0 || SearchBridge.rows.length == 0 {
                    return EventResult.reject;
                }
                if event.text == Key.UpArrow {
                    root.select(SearchBridge.selected - 1);
                    return EventResult.accept;
                }
                if event.text == Key.DownArrow {
                    root.select(SearchBridge.selected + 1);
                    return EventResult.accept;
                }
                if event.text == Key.Return {
                    SearchBridge.activate(SearchBridge.selected, 2);
                    return EventResult.accept;
                }
                if event.text == Key.Escape {
                    SearchBridge.close();
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
            list := ListView {
                visible: SearchBridge.replaced.length == 0;
                for row[index] in SearchBridge.rows: ResultRow {
                    item: row;
                    selected: index == SearchBridge.selected;
                    active: list-keys.has-focus;
                    clicked => {
                        list-keys.focus();
                        SearchBridge.selected = index;
                        SearchBridge.activate(index, 1);
                    }
                    double-clicked => {
                        SearchBridge.activate(index, 2);
                    }
                }
            }
            if SearchBridge.replaced.length == 0 && SearchBridge.rows.length == 0: Text {
                text: SearchBridge.searching || SearchBridge.status != "" ? "" : "Press Return to search";
                font-size: 13px;
                color: Theme.tertiary-text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if SearchBridge.replaced.length > 0: ReplacedList { }
        }
    }

    // Selects a row with the arrow keys, keeping it in view.
    function select(index: int) {
        if index < 0 || index >= SearchBridge.rows.length {
            return;
        }
        SearchBridge.selected = index;
        SearchBridge.activate(index, 0);
        let top = index * 26px;
        if top < -list.content-y {
            list.content-y = -top;
        } else if top + 26px > -list.content-y + list.visible-height {
            list.content-y = -(top + 26px - list.visible-height);
        }
    }

    // ↓ in the search field moves into the results.
    function enter-results() -> bool {
        if SearchBridge.rows.length == 0 || SearchBridge.replaced.length > 0 {
            return false;
        }
        list-keys.focus();
        if SearchBridge.selected < 0 {
            root.select(min(1, SearchBridge.rows.length - 1));
        }
        return true;
    }
}

// The preview of every change Replace in Files would make, to check before replacing.
export component ReplacePlanSheet inherits Rectangle {
    background: Theme.scrim;
    TouchArea { }

    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                SearchBridge.cancel-plan();
                return EventResult.accept;
            }
            if event.text == Key.Return {
                SearchBridge.apply-plan();
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }

    card := Rectangle {
        width: min(760px, parent.width - 80px);
        height: min(620px, parent.height - 100px);
        x: (parent.width - self.width) / 2;
        y: max(40px, (parent.height - self.height) / 3);
        border-radius: 14px;
        background: Theme.header-background;
        border-width: 1px;
        border-color: Theme.separator;
        drop-shadow-blur: 34px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: #00000059;
        clip: true;

        VerticalLayout {
            VerticalLayout {
                padding: 20px;
                padding-bottom: 14px;
                spacing: 4px;
                Text {
                    text: SearchBridge.plan-title;
                    font-size: 15px;
                    font-weight: 650;
                    color: Theme.primary-text;
                    overflow: elide;
                }
                Text {
                    text: SearchBridge.plan-summary;
                    font-size: 12px;
                    color: Theme.secondary-text;
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.separator;
            }
            Rectangle {
                vertical-stretch: 1;
                background: Theme.editor-background;
                ListView {
                    for row[index] in SearchBridge.plan: Rectangle {
                        height: row.kind == 0 ? 36px : row.lines * 36px + 10px;
                        if row.kind == 0: HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Checkbox {
                                    checked: row.included;
                                    toggled => { SearchBridge.plan-toggle(index); }
                                }
                            }
                            Text {
                                text: row.title;
                                font-size: 13px;
                                font-weight: 650;
                                color: row.included ? Theme.primary-text : Theme.tertiary-text;
                                vertical-alignment: center;
                            }
                            Text {
                                text: row.location;
                                font-size: 12px;
                                color: Theme.secondary-text;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: row.count;
                                font-size: 12px;
                                color: Theme.secondary-text;
                                vertical-alignment: center;
                            }
                        }
                        if row.kind == 1: HorizontalLayout {
                            padding-left: 44px;
                            padding-right: 18px;
                            padding-bottom: 10px;
                            spacing: 10px;
                            opacity: row.included ? 1 : 0.45;
                            Text {
                                width: 40px;
                                text: row.line;
                                font-family: Theme.mono-family;
                                font-size: 11px;
                                color: Theme.tertiary-text;
                                horizontal-alignment: right;
                                vertical-alignment: top;
                            }
                            VerticalLayout {
                                spacing: 2px;
                                Rectangle {
                                    height: row.lines * 17px + 2px;
                                    border-radius: 5px;
                                    background: Theme.syntax[23].with-alpha(Theme.dark ? 0.16 : 0.09);
                                    clip: true;
                                    if row.lines == 1: MarkedLine {
                                        x: 8px;
                                        parts: row.before-parts;
                                        color: Theme.primary-text;
                                        mark: Theme.syntax[23].with-alpha(Theme.dark ? 0.42 : 0.24);
                                    }
                                    if row.lines > 1: Text {
                                        x: 8px;
                                        width: parent.width - 16px;
                                        text: row.before;
                                        font-family: Theme.mono-family;
                                        font-size: 12px;
                                        color: Theme.primary-text;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle {
                                    height: row.lines * 17px + 2px;
                                    border-radius: 5px;
                                    background: Theme.syntax[22].with-alpha(Theme.dark ? 0.18 : 0.10);
                                    clip: true;
                                    if row.lines == 1: MarkedLine {
                                        x: 8px;
                                        parts: row.after-parts;
                                        color: Theme.primary-text;
                                        mark: Theme.syntax[22].with-alpha(Theme.dark ? 0.42 : 0.24);
                                    }
                                    if row.lines > 1: Text {
                                        x: 8px;
                                        width: parent.width - 16px;
                                        text: row.after;
                                        font-family: Theme.mono-family;
                                        font-size: 12px;
                                        color: Theme.primary-text;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.separator;
            }
            HorizontalLayout {
                padding: 16px;
                spacing: 8px;
                alignment: end;
                PillButton {
                    text: "Cancel";
                    clicked => { SearchBridge.cancel-plan(); }
                }
                PillButton {
                    text: "Replace";
                    primary: true;
                    clicked => { SearchBridge.apply-plan(); }
                }
            }
        }
    }
}
