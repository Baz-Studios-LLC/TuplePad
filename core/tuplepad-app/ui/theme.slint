}

export global Theme {
    // 0 follows the system, 1 is always light, 2 always dark.
    in-out property <int> appearance: 0;
    // 0 TuplePad, 1 Midnight.
    in-out property <int> theme: 0;
    out property <bool> system-dark: Palette.color-scheme == ColorScheme.dark;
    out property <bool> dark: appearance == 0 ? system-dark : appearance == 2;
    out property <ThemeColors> colors: theme == 1
        ? (dark ? Themes.midnight-dark : Themes.midnight-light)
        : (dark ? Themes.tuplepad-dark : Themes.tuplepad-light);

    out property <color> accent: colors.accent;
    out property <color> accent-text: colors.accent-text;
    out property <color> editor-background: colors.editor-background;
    out property <color> text: colors.text;
    out property <color> line-number: colors.line-number;
    out property <color> current-line-number: colors.current-line-number;
    out property <color> current-line: colors.current-line;
    out property <color> selection: colors.selection;
    out property <color> occurrence: colors.occurrence;
    out property <color> bracket: colors.bracket;
    out property <color> bracket-border: colors.bracket-border;
    out property <color> caret: colors.caret;
    out property <color> preedit-underline: colors.preedit-underline;
    out property <color> indent-guide: colors.indent-guide;
    out property <color> sidebar-background: colors.sidebar-background;
    out property <color> sidebar-hover: colors.sidebar-hover;
    out property <color> separator: colors.separator;
    out property <color> header-background: colors.header-background;
    out property <color> status-background: colors.status-background;
    out property <color> primary-text: colors.primary-text;
    out property <color> secondary-text: colors.secondary-text;
    out property <color> tertiary-text: colors.tertiary-text;
    out property <color> scrollbar-thumb: colors.scrollbar-thumb;
    out property <color> control-hover: colors.control-hover;
    out property <color> control-pressed: colors.control-pressed;
    out property <color> icon: colors.icon;
    out property <color> control-border: colors.control-border;
    out property <color> scrim: colors.scrim;
    out property <color> drop-tint: colors.drop-tint;
    out property <color> selected-row: colors.selected-row;
    out property <color> selected-row-text: colors.selected-row-text;
    out property <color> selected-row-detail: colors.selected-row-detail;
    out property <color> selected-badge: colors.selected-badge;
    out property <[color]> syntax: colors.syntax;

    // Fonts
    out property <length> ui-font-size: 13px;
    in-out property <string> mono-family: "Menlo";
}
