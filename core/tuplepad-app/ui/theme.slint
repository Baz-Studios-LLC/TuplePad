            #1D1D1F, #7C3AAD, #A3611B, #C2402A, #8B93A1, #C2410C, #C2410C, #2F5FC4, #0E7C86,
            #1D1D1F, #3E5F7D, #1F7FA8, #6B7280, #C2273D, #A15C00, #7C3AAD, #3E5F7D, #2F5FC4,
            #1D1D1F, #1D1D1F, #1F7FA8, #A3611B, #2E7D32, #C2273D, #C7C7CC,
        ],
    };
    out property <ThemeColors> tuplepad-dark: {
        accent: #2F5596,
