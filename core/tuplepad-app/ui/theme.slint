// Generated by scripts/make-themes.py from its theme table; edit the table there and rerun.

import { Palette } from "std-widgets.slint";

// The colors of one theme in light or dark. Syntax colors are indexed by `Span.style`: 0 is plain
// text, 1–23 follow HighlightStyle in the core (keyword, string, escape, comment, number,
// constant, function, type, variable, property, operator, punctuation, tag, attribute, label,
// namespace, heading, emphasis, strong, link, code, inserted, deleted), and 24 is invisibles.
export struct ThemeColors {
    accent: color,
    accent-text: color,
    editor-background: color,
    text: color,
    line-number: color,
    current-line-number: color,
    current-line: color,
    selection: color,
    occurrence: color,
    bracket: color,
    bracket-border: color,
    caret: color,
    preedit-underline: color,
    indent-guide: color,
    sidebar-background: color,
    sidebar-hover: color,
    separator: color,
    header-background: color,
    status-background: color,
    primary-text: color,
    secondary-text: color,
    tertiary-text: color,
    scrollbar-thumb: color,
    control-hover: color,
    control-pressed: color,
    icon: color,
    control-border: color,
    scrim: color,
    drop-tint: color,
    selected-row: color,
    selected-row-text: color,
    selected-row-detail: color,
    selected-badge: color,
    find-match: color,
    mark: color,
    // The selected sidebar row is filled with the accent (instead of a quiet highlight).
    filled-selection: bool,
    syntax: [color],
}

