import { Palette } from "std-widgets.slint";

// The colors of one theme in light or dark. Syntax colors are indexed by `Span.style`: 0 is plain
// text, 1–23 follow HighlightStyle in the core (keyword, string, escape, comment, number,
// constant, function, type, variable, property, operator, punctuation, tag, attribute, label,
// namespace, heading, emphasis, strong, link, code, inserted, deleted), and 24 is invisibles.
export struct ThemeColors {
    accent: color,
    accent-text: color,
    editor-background: color,
    text: color,
    line-number: color,
    current-line-number: color,
    current-line: color,
    selection: color,
    occurrence: color,
    bracket: color,
    bracket-border: color,
    caret: color,
    preedit-underline: color,
    indent-guide: color,
    sidebar-background: color,
    sidebar-hover: color,
    separator: color,
    header-background: color,
    status-background: color,
    primary-text: color,
    secondary-text: color,
    tertiary-text: color,
    scrollbar-thumb: color,
    control-hover: color,
    control-pressed: color,
    icon: color,
    control-border: color,
    scrim: color,
    drop-tint: color,
    selected-row: color,
    selected-row-text: color,
    selected-row-detail: color,
    selected-badge: color,
    syntax: [color],
}

// The themes. TuplePad is neutral, with midnight blue only as the accent; Midnight is ivory and
// navy by day and ivory on midnight blue at night.
global Themes {
    out property <ThemeColors> tuplepad-light: {
        accent: #103474,
        accent-text: #FFFFFF,
        editor-background: #FFFFFF,
        text: #1D1D1F,
        line-number: #B4B4BA,
        current-line-number: #6E6E73,
        current-line: #0000000A,
        selection: #10347429,
        occurrence: #10347414,
        bracket: #10347420,
        bracket-border: #10347459,
        caret: #103474,
        preedit-underline: #103474,
        indent-guide: #00000012,
        sidebar-background: #F4F4F6,
        sidebar-hover: #0000000A,
        separator: #E2E2E6,
        header-background: #FFFFFF,
        status-background: #FAFAFB,
        primary-text: #1D1D1F,
        secondary-text: #86868B,
        tertiary-text: #AEAEB2,
        scrollbar-thumb: #0000004D,
        control-hover: #0000000D,
        control-pressed: #00000017,
        icon: #6E6E73,
        control-border: #00000024,
        scrim: #00000038,
        drop-tint: #10347414,
